# Ignore OS junk
.DS_Store
Thumbs.db

# Ignore global node_modules
node_modules/
**/node_modules/

# Ignore environment files (protect all variations except .env.example templates)
*.env*
**/*.env*
!*.env.example
!**/.env.example

# Ignore local AI agent and assistant caches
.agents/
.aider-desk/
skills-lock.json

# Ignore backups and logs
*.log
*.bak
*.backup

# Ignore editor and IDE folders
.vscode/
.idea/

# ===== STUDY MATERIAL MOVED TO SUPABASE (2026-09-19) =====
# All resource files now live in Supabase Storage or external repositories.
# The folder is kept OUT of git so the repository stays light.
/resources/

# Ignore build outputs from any folder
**/dist/
**/build/
**/.cache/
**/tmp/
**/.astro/
frontend/public/frontend/src/

# Local tooling artifacts (never commit these)
*.err
backend/scripts/.tmp-*
