# ===== BACKEND ENV TEMPLATE =====
# Copy to `backend/.env` (which is git-ignored) and fill in development values.
# NEVER commit the real .env file or production credentials.

# ---------- Server ----------
NODE_ENV=development
PORT=4000
BASE_URL=http://localhost:4000

# Allowed CORS origins (comma-separated exact origins)
STUDY_HUB_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# ---------- Supabase Configuration ----------
# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only key used for administrative actions and uploads. NEVER expose in frontend.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_RESOURCES_BUCKET=study-hub-resources
SUPABASE_RESOURCES_PREFIX=documents
SUPABASE_RESOURCES_TABLE=study_hub_resources

# ---------- Database (PostgreSQL) ----------
# Local PostgreSQL development credentials:
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=studyhub

# PostgreSQL connection string (preferred by Sequelize).
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studyhub
DATABASE_SSL=false
DATABASE_SSL_CA=

# Legacy MongoDB fallback (optional / not required for modern features)
MONGO_URI=mongodb://localhost:27017/studyhub

# ---------- Authentication ----------
# Secret key for signing JWTs. Must be at least 32 characters long.
JWT_SECRET=your-random-32-character-secret-key-goes-here

# ---------- Document Payments (UGX 1,000 Mobile Money Verification) ----------
# In local development, use a dummy telephone number. Never commit personal phone numbers.
PAYMENT_RECEIVER_PHONE=0700000000

# ---------- Premium Resource Archive Uploads ----------
# Server-side GitHub fine-grained token with Contents read/write access.
# Leave blank unless testing archive upload scripts.
GITHUB_RESOURCES_PAT=

# ---------- AI Services ----------
# Google Gemini API key for academic tutoring and study plans.
# Primary model defaults to gemini-3.5-flash, with automatic fallback to gemini-3.5-flash-lite.
# Configure models available to your Gemini API key tier.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
STUDY_RESOURCE_GEMINI_MODEL=gemini-3.5-flash

# OpenAI API key (for text-embedding-3-small topic memory with pgvector).
# Optional: numbered keys provide sequential failover.
OPENAI_API_KEY=your-openai-api-key
OPEN_AI_API_KEY=
OPEN_AI_API_KEY_1=
OPEN_AI_API_KEY_2=

# Future AI providers (optional)
GROQ_API_KEY=

# ---------- Cloud Storage (Legacy AWS S3 fallback) ----------
CLOUD_PROVIDER=aws
CLOUD_ACCESS_KEY=
CLOUD_SECRET_KEY=
CLOUD_BUCKET=studyhub-files

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
