# ===== BACKEND ENV TEMPLATE =====
# Copy to `backend/.env` (which is git-ignored) and fill in real values.
# NEVER commit the real .env file.

# ---------- Server ----------
NODE_ENV=development
PORT=4000
BASE_URL=http://localhost:4000

# ---------- Supabase (resources live here now, not in GitHub) ----------
# Project settings -> API -> Project URL / anon key / service_role key
SUPABASE_URL=https://ttuxelhyoctyshgvjykj.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InR0dXhlbGh5b2N0eXNoZ3ZqeWtqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk4MTUxMjAsImV4cCI6MjEwNTM5MTEyMH0.pHHm2jWhaWNMUkMR5wpUEFGf7kwk3wFJ_2Wr4oG1xrY
# Secret! Only used locally / on the server for uploads and admin access.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InR0dXhlbGh5b2N0eXNoZ3ZqeWtqIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4OTgxNTEyMCwiZXhwIjoyMTA1MzkxMTIwfQ.Ib9lyHfPK1xcPYNjOomn-2cKHqo5oyF7MVdJ7QaxcKM
SUPABASE_RESOURCES_BUCKET=study-hub-resources
SUPABASE_RESOURCES_PREFIX=documents
# Table that indexes the files. Namespaced so it never collides with another
# app's own `resources` table living in the same Supabase project.
SUPABASE_RESOURCES_TABLE=study_hub_resources
# Optional: path to the generated manifest used as an offline fallback.
# RESOURCES_MANIFEST=./data/resources-manifest.json

# ---------- Databases (existing backend code) ----------
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=studyhub
DB_HOST=localhost
DB_PORT=5432
DB_NAME=studyhub
DB_USER=postgres
DB_PASS=postgres
# Use the PostgreSQL connection string from your provider (for Supabase, Dashboard > Connect).
# It must start with postgres:// or postgresql://; do not use the Supabase HTTPS project URL.
# Keep this connection string secret.
# In production, TLS is enabled by default. Set DATABASE_SSL_CA to the database provider's
# PEM CA certificate when needed (for Supabase, download it from Database Settings > SSL).
DATABASE_URL=
DATABASE_SSL=
DATABASE_SSL_CA=
MONGO_URI=mongodb://localhost:27017/studyhub

# ---------- Auth ----------
# Required for sign-in and account creation. Use a unique, random secret of at least 32 characters.
JWT_SECRET=

# ---------- Document payment verification ----------
# The public receiving number is configured with PUBLIC_STUDY_HUB_PAYMENT_PHONE in the frontend build.

# ---------- AI ----------
# OpenAI keys are tried in order. Numbered keys provide failover on quota, auth, or service errors.
OPEN_AI_API_KEY=
OPEN_AI_API_KEY_1=
OPEN_AI_API_KEY_2=
# Backward-compatible aliases for existing deployments.
OPENAI_API_KEY=
OPENAI_KEY=
GEMINI_API_KEY=
# Optional Gemini model override; defaults to Gemini 3.8 Flash.
GEMINI_MODEL=gemini-3.8-flash
# Used automatically when the primary model is busy or unavailable.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Groq key for a future Groq service integration; this is not xAI Grok.
GROQ_API_KEY=

# ---------- Other cloud storage (legacy, see services/storageService.js) ----------
CLOUD_PROVIDER=aws
CLOUD_ACCESS_KEY=
CLOUD_SECRET_KEY=
CLOUD_BUCKET=studyhub-files

# ---------- Google OAuth / YouTube ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback