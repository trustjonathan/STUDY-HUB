# EditorConfig configuration for STUDY HUB
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,mjs,cjs,ts,tsx,jsx,astro}]
indent_size = 2

[*.{json,yml,yaml,md}]
indent_size = 2

[*.sql]
indent_size = 2

[Makefile]
indent_style = tab
