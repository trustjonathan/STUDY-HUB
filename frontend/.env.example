# Frontend Environment Variables Template
# Copy this file to `frontend/.env` for local development.
# NEVER commit real credentials or production secrets.

# Supabase Public Configuration (from Supabase Project Settings -> API)
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Study Hub Backend API URL (use http://localhost:4000 for local Express backend)
# When set to empty or unreachable, frontend runs in standalone/catalog-only mode.
PUBLIC_STUDY_HUB_API_URL=http://localhost:4000

# Google Sign-In (Client ID for web application; secret stays in Supabase dashboard)
PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Mobile Money Test/Business Phone (UGX 1,000 document downloads)
# Use a dummy phone number in local development (e.g. 0700000000). Never commit personal numbers.
PUBLIC_STUDY_HUB_PAYMENT_PHONE=0700000000
