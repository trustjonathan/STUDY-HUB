---
import AuthPanel from '../components/AuthPanel';
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/auth.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const apiUrl = import.meta.env.PUBLIC_STUDY_HUB_API_URL?.trim() ?? '';
const googleClientId = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID?.trim() ?? '';
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL?.trim() ?? '';
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY?.trim() ?? '';
---

<SiteLayout
  title="Sign in | Study Hub"
  description="Sign in or create a Study Hub account to personalise your class and subject resources and get more relevant AI Study guidance."
>
  <AuthPanel client:load apiUrl={apiUrl} googleClientId={googleClientId} supabaseUrl={supabaseUrl} supabaseAnonKey={supabaseAnonKey} showOneTap homeHref={base || '/'} />
</SiteLayout>
