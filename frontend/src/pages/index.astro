---
import SiteLayout from '../layouts/SiteLayout.astro';
import subjectCatalog from '../data/subjects.json';
import aLevelCombinations from '../data/aLevelCombinations.json';
import { subjectCategories } from '../data/subjectCategories';

const base = `${import.meta.env.BASE_URL}/`;
const categories = subjectCategories.map((category) => ({
  ...category,
  subjects: subjectCatalog.filter((subject) => subject.category === category.id)
}));
const featuredSlugs = ['biology', 'chemistry', 'mathematics', 'physics', 'ict'];
const featuredSubjects = featuredSlugs
  .map((slug) => subjectCatalog.find((subject) => subject.slug === slug))
  .filter((subject) => subject !== undefined);
---

<SiteLayout>
  <main>
    <section class="hero-section" id="overview">
      <div class="hero-copy">
        <p class="eyebrow">Study resources, in one place</p>
        <h1>Make your next study session count.</h1>
        <p class="hero-description">
          Find subject notes, exam papers, and focused study tools built to help you learn with clarity.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#subject-categories">Explore categories <span aria-hidden="true">→</span></a>
          <a class="text-link" href={`${base}subjects.html`}>Browse all {subjectCatalog.length} subjects</a>
        </div>
        <div class="hero-note">
          <span class="note-mark" aria-hidden="true">+</span>
          <p>Curriculum-aware resources for independent revision.</p>
        </div>
      </div>
      <aside class="study-brief" aria-label="Study Hub overview">
        <div class="brief-topline"><span>STUDY HUB</span><span>{subjectCatalog.length} SUBJECTS</span></div>
        <div class="brief-rule"></div>
        <p class="brief-label">Start with a subject</p>
        <ol>
          <li><span>01</span><strong>Choose a topic</strong></li>
          <li><span>02</span><strong>Review the notes</strong></li>
          <li><span>03</span><strong>Practice exam questions</strong></li>
        </ol>
        <p class="brief-foot">A focused path from understanding to practice.</p>
      </aside>
    </section>

    <section class="subjects-section" id="subject-categories">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Browse by area</p>
          <h2>Find your subject</h2>
        </div>
        <p>Start with a category or jump straight to the full searchable directory.</p>
      </div>
      <div class="category-preview-grid">
        {categories.map((category, index) => (
          <article class="category-preview">
            <div class="category-preview-topline">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <span>{category.subjects.length} subjects</span>
            </div>
            <div class="category-preview-body">
              <h3>{category.label}</h3>
              <p>{category.description}</p>
              <ul>
                {category.subjects.slice(0, 4).map((subject) => (
                  <li><a href={`${base}frontend/src/html/${subject.slug}.html`}>{subject.name}</a></li>
                ))}
              </ul>
            </div>
            <a class="category-preview-link" href={`${base}subjects.html?category=${category.id}`}>
              Explore category <span aria-hidden="true">↗</span>
            </a>
          </article>
        ))}
      </div>
      <div class="featured-subjects">
        <h3>Popular subjects</h3>
        <nav aria-label="Popular subjects">
          {featuredSubjects.map((subject) => (
            <a href={`${base}frontend/src/html/${subject.slug}.html`}>{subject.name}</a>
          ))}
        </nav>
      </div>
      <a class="button button-primary directory-cta" href={`${base}subjects.html`}>
        Browse all {subjectCatalog.length} subjects <span aria-hidden="true">→</span>
      </a>
    </section>

    <section class="combination-guide" id="combinations" aria-labelledby="combination-heading">
      <div class="combination-heading">
        <p class="eyebrow">Plan your A-Level path</p>
        <h2 id="combination-heading">Common subject combinations</h2>
        <p>Students choose three principal subjects and two subsidiaries: General Paper (S101) plus Subsidiary ICT (S850) or Subsidiary Mathematics (S475), depending on the principal Mathematics choice. Examples are guidance; confirm current requirements with your school and UNEB.</p>
      </div>
      <div class="combination-grid">
        {aLevelCombinations.map((combination) => (
          <article class="combination-card">
            <h3>{combination.category}</h3>
            <p class="combination-examples">{combination.examples.join(' · ')}</p>
            <p>{combination.careers}</p>
          </article>
        ))}
      </div>
    </section>
  </main>
</SiteLayout>