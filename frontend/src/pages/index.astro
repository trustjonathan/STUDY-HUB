---
import SiteLayout from '../layouts/SiteLayout.astro';
import subjectCatalog from '../data/subjects.json';
import aLevelCombinations from '../data/aLevelCombinations.json';

const base = `${import.meta.env.BASE_URL}/`;
const subjects = subjectCatalog.map((subject) => ({
  ...subject,
  href: `${base}frontend/src/html/${subject.slug}.html`
}));
---

<SiteLayout>
  <main>
    <section class="hero-section" id="overview" data-scroll-reveal>
      <div class="hero-copy">
        <p class="eyebrow">Study resources, in one place</p>
        <h1>Make your next study session count.</h1>
        <p class="hero-description">
          Find subject notes, exam papers, and focused study tools built to help you learn with clarity.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#subjects">Explore subjects <span aria-hidden="true">→</span></a>
          <a class="text-link" href="https://trustjonathan.github.io/BIOLOGY/archive.html#archive">Go to exam practice</a>
        </div>
        <div class="hero-note">
          <span class="note-mark" aria-hidden="true">+</span>
          <p>Curriculum-aware resources for independent revision.</p>
        </div>
      </div>
      <aside class="study-brief" aria-label="Study Hub overview">
        <div class="brief-topline"><span>STUDY HUB</span><span>{subjects.length} SUBJECTS</span></div>
        <div class="brief-rule"></div>
        <p class="brief-label">Start with a subject</p>
        <ol>
          <li><span>01</span><strong>Choose a topic</strong></li>
          <li><span>02</span><strong>Review the notes</strong></li>
          <li><span>03</span><strong>Practice exam questions</strong></li>
        </ol>
        <p class="brief-foot">A focused path from understanding to practice.</p>
      </aside>
    </section>

    <section class="subjects-section" id="subjects" data-scroll-reveal>
      <div class="section-heading">
        <div>
          <p class="eyebrow">Choose your direction</p>
          <h2>Study by subject</h2>
        </div>
        <p>Explore UNEB/NCDC O-Level, A-Level, and subsidiary subjects, then browse notes and exam practice.</p>
      </div>
      <div class="subject-grid">
        {subjects.map((subject, index) => (
          <article class={`subject-card ${subject.slug}`}>
            <div class="subject-index">{String(index + 1).padStart(2, '0')}</div>
            <div class="subject-card-body">
              <p class="subject-focus">{subject.focus}</p>
              <h3>{subject.name}</h3>
              <p>{subject.description}</p>
              <p class="subject-levels">
                {subject.tracks.join(' · ')}
                {subject.codes.length > 0 && ` · ${subject.codes.map(({ code }) => code).join(', ')}`}
              </p>
              <a href={subject.href} aria-label={`Open ${subject.name} study hub`}>
                Open study hub <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
      <div class="combination-guide" aria-labelledby="combination-heading">
        <div class="combination-heading">
          <p class="eyebrow">Plan your A-Level path</p>
          <h3 id="combination-heading">Common subject combinations</h3>
          <p>Students choose three principal subjects and two subsidiaries: General Paper (S101) plus Subsidiary ICT (S850) or Subsidiary Mathematics (S475), depending on the principal Mathematics choice. Examples are guidance; confirm current requirements with your school and UNEB.</p>
        </div>
        <div class="combination-grid">
          {aLevelCombinations.map((combination) => (
            <article class="combination-card">
              <h4>{combination.category}</h4>
              <p class="combination-examples">{combination.examples.join(' · ')}</p>
              <p>{combination.careers}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="practice-section" id="practice" data-scroll-reveal>
      <div class="practice-copy">
        <p class="eyebrow">Prepare with purpose</p>
        <h2>Turn what you know into exam confidence.</h2>
        <p>Use past papers to test your understanding and spot the topics worth revisiting.</p>
      </div>
      <a class="button button-light" href="https://trustjonathan.github.io/BIOLOGY/archive.html#archive">
        Browse exam papers <span aria-hidden="true">→</span>
      </a>
    </section>
  </main>
</SiteLayout>

<script>
  const revealTargets = document.querySelectorAll<HTMLElement>('[data-scroll-reveal]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reducedMotion && 'IntersectionObserver' in window) {
    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -36px 0px' });

    revealTargets.forEach((target) => {
      target.classList.add('scroll-reveal');
      revealObserver.observe(target);
    });
  }
</script>