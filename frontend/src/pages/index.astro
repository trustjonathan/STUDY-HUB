---
import SiteLayout from '../layouts/SiteLayout.astro';

const base = `${import.meta.env.BASE_URL}/`;
const subjects = [
  {
    name: 'Biology',
    theme: 'biology',
    focus: 'Life sciences',
    description: 'Explore life processes, genetics, ecology, and practical work.',
    href: `${base}frontend/src/html/biology.html`
  },
  {
    name: 'Chemistry',
    theme: 'chemistry',
    focus: 'Matter & reactions',
    description: 'Connect chemical principles to reactions, equations, and experiments.',
    href: `${base}frontend/src/html/chemistry.html`
  },
  {
    name: 'Mathematics',
    theme: 'mathematics',
    focus: 'Methods & practice',
    description: 'Build confidence through worked examples and exam preparation.',
    href: `${base}frontend/src/html/mathematics.html`
  }
];
---

<SiteLayout>
  <main>
    <section class="hero-section" id="overview">
      <div class="hero-copy">
        <p class="eyebrow">Study resources, in one place</p>
        <h1>Make your next study session count.</h1>
        <p class="hero-description">
          Find subject notes, exam papers, and focused study tools built to help you learn with clarity.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#subjects">Explore subjects <span aria-hidden="true">→</span></a>
          <a class="text-link" href="https://trustjonathan.github.io/BIOLOGY/archive.html#archive">Go to exam practice</a>
        </div>
        <div class="hero-note">
          <span class="note-mark" aria-hidden="true">+</span>
          <p>Curriculum-aware resources for independent revision.</p>
        </div>
      </div>
      <aside class="study-brief" aria-label="Study Hub overview">
        <div class="brief-topline"><span>STUDY HUB</span><span>01 / 03</span></div>
        <div class="brief-rule"></div>
        <p class="brief-label">Start with a subject</p>
        <ol>
          <li><span>01</span><strong>Choose a topic</strong></li>
          <li><span>02</span><strong>Review the notes</strong></li>
          <li><span>03</span><strong>Practice exam questions</strong></li>
        </ol>
        <p class="brief-foot">A focused path from understanding to practice.</p>
      </aside>
    </section>

    <section class="subjects-section" id="subjects">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Choose your direction</p>
          <h2>Study by subject</h2>
        </div>
        <p>Open a subject hub to explore its notes, papers, and learning resources.</p>
      </div>
      <div class="subject-grid">
        {subjects.map((subject, index) => (
          <article class={`subject-card ${subject.theme}`}>
            <div class="subject-index">0{index + 1}</div>
            <div class="subject-card-body">
              <p class="subject-focus">{subject.focus}</p>
              <h3>{subject.name}</h3>
              <p>{subject.description}</p>
              <a href={subject.href} aria-label={`Open ${subject.name} study hub`}>
                Open study hub <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="practice-section" id="practice">
      <div class="practice-copy">
        <p class="eyebrow">Prepare with purpose</p>
        <h2>Turn what you know into exam confidence.</h2>
        <p>Use past papers to test your understanding and spot the topics worth revisiting.</p>
      </div>
      <a class="button button-light" href="https://trustjonathan.github.io/BIOLOGY/archive.html#archive">
        Browse exam papers <span aria-hidden="true">→</span>
      </a>
    </section>
  </main>
</SiteLayout>