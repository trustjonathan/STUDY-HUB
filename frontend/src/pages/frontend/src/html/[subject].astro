---
import LegacyPageLayout from "../../../../layouts/LegacyPageLayout.astro";
import SubjectDashboard from "../../../../components/SubjectDashboard.astro";
import { availableSubjects } from "../../../../data/availableSubjects";

export function getStaticPaths() {
  return availableSubjects.map((subject) => ({
    params: { subject: subject.slug },
    props: { subject },
  }));
}

const { subject } = Astro.props;
const levelLabel = subject.levels.join(", ");
---

<LegacyPageLayout
  title={`${subject.name} Study Hub | UNEB ${levelLabel}`}
  description={`${subject.description} Find ${subject.name} resources and exam practice for Ugandan ${levelLabel} learners.`}
  dataPage={subject.slug}
>
  <Fragment slot="head">
    <meta name="keywords" content={`${subject.name}, UNEB, NCDC, ${levelLabel}, study notes, past papers`}>
    <link rel="stylesheet" href="../styles/home.css">
    <link rel="stylesheet" href="../styles/themes.css">
    <link rel="stylesheet" href="../styles/mathematics.css">
  </Fragment>

  <div id="container">
    <SubjectDashboard
      subject={subject.slug}
      name={subject.name}
      icon={subject.icon}
      headline={subject.headline}
      description={subject.description}
    />
  </div>
</LegacyPageLayout>
