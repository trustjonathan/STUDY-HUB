---
import LegacyPageLayout from "../../../../layouts/LegacyPageLayout.astro";
import SubjectDashboard from "../../../../components/SubjectDashboard.astro";
---

<LegacyPageLayout
  title="Biology Study Hub | Study Hub"
  description="Explore Biology revision topics, level-specific study prompts, and resources from the shared Study Hub catalogue."
  dataPage="biology"
>
  <Fragment slot="head">
    <meta name="google-site-verification" content="sfHZ25XlkVnxKqIxzyH05-ZSdGWMMvXok7V3de4N0PY">
    <meta name="keywords" content="biology, study guide, revision topics, learning resources">
    <meta name="author" content="Jonathan">
    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "EducationalOrganization",
        "name": "Study Hub",
        "url": "https://trustjonathan.github.io/STUDY-HUB/",
        "logo": "https://trustjonathan.github.io/STUDY-HUB/favicon.svg",
        "description": "Study resources and tools for learners.",
        "sameAs": []
      }
    </script>
    <link rel="stylesheet" href="../styles/home.css">
    <link rel="stylesheet" href="../styles/themes.css">
    <link rel="stylesheet" href="../styles/mathematics.css">
  </Fragment>

  <div id="container">
    <SubjectDashboard
      subject="biology"
      name="Biology"
      icon="🧬"
      headline="Explore the science of living things."
      description="Explore life processes, genetics, ecology, and practical work."
    />
  </div>
</LegacyPageLayout>
