                <button onclick="startTimer()"
                  style="background: #2e7d32; color: white; border: none; padding: 10px 20px; border-radius: 6px; font-weight: bold; cursor: pointer; margin-right: 5px;">Start</button>
                <button onclick="pauseTimer()"
                  style="background: #f57c00; color: white; border: none; padding: 10px 20px; border-radius: 6px; font-weight: bold; cursor: pointer; margin-right: 5px;">Pause</button>
