  <script is:inline>
    // ==== MATH PLAYLIST SETUP ====
    const mathPlaylistID = "PLszahHibLDAKZk-CoRBpeqWAnU5GwlxFi";
    const apiKey = "AIzaSyDl6qH2viYqcDiCVyUQ8kT7TsiWNcmyRjU";

    // Elements
    const mathBtn = document.querySelector(".math-btn");
    const mathPanel = document.getElementById("math-videos");
    const mathBackBtn = document.getElementById("math-back-btn");
    const mathList = document.getElementById("math-video-list");

    let mathLoaded = false;

    // === OPEN PANEL ===
    mathBtn.addEventListener("click", () => {
      mathPanel.classList.add("open");
      if (!mathLoaded) {
        loadMathVideos();
        mathLoaded = true;
      }
    });

    // === PHONE: Close with back button ===
    mathBackBtn.addEventListener("click", () => {
      mathPanel.classList.remove("open");
    });

    // === PC: Close by clicking outside ===
    document.addEventListener("click", (e) => {
      const clickedInside = mathPanel.contains(e.target) || mathBtn.contains(e.target);
      const isPhone = window.innerWidth <= 768;

      if (!clickedInside && !isPhone) {
        mathPanel.classList.remove("open");
      }
    });

    // === Load ALL Math Videos using nextPageToken ===
    async function loadMathVideos(pageToken = "") {
      if (!pageToken) {
        mathList.innerHTML = "<p>Loading...</p>";
      }

      try {
        const url =
          `https://www.googleapis.com/youtube/v3/playlistItems?` +
          `part=snippet&maxResults=50&playlistId=${mathPlaylistID}&key=${apiKey}` +
          (pageToken ? `&pageToken=${pageToken}` : "");

        const res = await fetch(url);
        const data = await res.json();

        if (!pageToken) mathList.innerHTML = ""; // Clear only on first request

        data.items.forEach(item => {
          const vid = item.snippet.resourceId.videoId;

          const card = document.createElement("div");
          card.innerHTML = `
            <div style="margin-bottom:20px;">
              <iframe width="100%" height="220"
                src="https://www.youtube.com/embed/${vid}"
                frameborder="0" allowfullscreen></iframe>
              <h4>${item.snippet.title}</h4>
            </div>
          `;

          mathList.appendChild(card);
        });

        // ▶️ Load next page if available
        if (data.nextPageToken) {
          await loadMathVideos(data.nextPageToken);
        }

      } catch (error) {
        mathList.innerHTML = "<p>Failed to load videos.</p>";
      }
    }
  </script>


