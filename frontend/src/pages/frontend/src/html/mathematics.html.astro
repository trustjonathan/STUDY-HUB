            <script is:inline>
              let timeLeft = 25 * 60;
              let timerInterval = null;
              let isWorkMode = true;

              function updateDisplay() {
                const minutes = Math.floor(timeLeft / 60);
                const seconds = timeLeft % 60;
                document.getElementById('timer-display').textContent =
                  `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
              }

              function startTimer() {
                if (timerInterval !== null) return;
                timerInterval = setInterval(() => {
                  if (timeLeft > 0) {
                    timeLeft--;
                    updateDisplay();
                  } else {
                    clearInterval(timerInterval);
                    timerInterval = null;
                    isWorkMode = !isWorkMode;
                    timeLeft = isWorkMode ? 25 * 60 : 5 * 60;
                    document.getElementById('timer-label').textContent = isWorkMode ? '🧠 Focus Session (25m)' : '☕ Short Break (5m)';
                    alert(isWorkMode ? 'Break over! Time to get into Beast Mode!' : 'Great job! Take a 5-minute break.');
                    updateDisplay();
                  }
                }, 1000);
              }

              function pauseTimer() {
                clearInterval(timerInterval);
                timerInterval = null;
              }

              function resetTimer() {
                pauseTimer();
                isWorkMode = true;
                timeLeft = 25 * 60;
                document.getElementById('timer-label').textContent = '🧠 Focus Session (25m)';
                updateDisplay();
              }
            </script>

