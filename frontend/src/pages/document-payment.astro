---
import SiteLayout from '../layouts/SiteLayout.astro';
import DocumentPaymentCheckout from '../components/DocumentPaymentCheckout';
import '../styles/document-payments.css';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const apiUrl = (import.meta.env.PUBLIC_STUDY_HUB_API_URL || '').trim();
const receiverPhone = (import.meta.env.PUBLIC_STUDY_HUB_PAYMENT_PHONE || '0701810497').trim();
---

<SiteLayout title="Document payment | Study Hub" description="Submit a Mobile Money payment for Study Hub document delivery.">
  <DocumentPaymentCheckout client:load apiUrl={apiUrl} base={base} receiverPhone={receiverPhone} />
</SiteLayout>
