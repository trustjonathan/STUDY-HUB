---
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/library-guide.css';
import biologyImage from '../assets/images/biology.jpg';
import chemistryImage from '../assets/images/chemistry.jpg';
import mathematicsImage from '../assets/images/mathematics.jpg';
import studentsImage from '../assets/images/students_studying.jpeg';
import studyImage from '../assets/images/study_pic.png';
import { availableSubjects } from '../data/availableSubjects';

const home = import.meta.env.BASE_URL.replace(/\/$/, '');
const subjects = [
  {
    name: 'Biology',
    image: biologyImage,
    hub: `${home}/frontend/src/html/biology`,
    archive: 'https://trustjonathan.github.io/BIOLOGY/archive.html'
  },
  {
    name: 'Chemistry',
    image: chemistryImage,
    hub: `${home}/frontend/src/html/chemistry`,
    archive: 'https://trustjonathan.github.io/CHEMISTRY/archive.html'
  },
  {
    name: 'Mathematics',
    image: mathematicsImage,
    hub: `${home}/frontend/src/html/mathematics`,
    archive: 'https://trustjonathan.github.io/MATHEMATICS/archive.html'
  }
];
---

<SiteLayout
  title="Study Hub Library Guide"
  description="A guide to Study Hub subjects, the shared resource library, navigation, searching, and submitting study materials."
>
  <main class="library-guide">
    <section class="guide-intro" id="guide-start" aria-labelledby="guide-title">
      <div class="guide-intro-copy">
        <p class="eyebrow">Study Hub reference</p>
        <h1 id="guide-title">The library, explained.</h1>
        <p class="guide-lede">Browse subject pages, search the shared library, and learn how contributed files are reviewed before they become public.</p>
        <p class="guide-updated">The shared Library displays catalogue provenance and its latest update date.</p>
      </div>
      <img class="guide-hero-image" src={studentsImage.src} alt="Learners studying together" />
    </section>

    <div class="guide-layout">
      <aside class="guide-contents" aria-label="Guide contents">
        <p class="guide-contents-title">On this page</p>
        <nav>
          <a href="#how-it-works">
            <img src={studyImage.src} alt="" />
            <span>How the library works</span>
          </a>
          <a href="#site-tour">
            <img src={`${home}/assets/library-guide/library-shelf.png`} alt="" />
            <span>Visual site tour</span>
          </a>
          <a href={`${home}/library.html`}>
            <img src={mathematicsImage.src} alt="" />
            <span>Browse resources</span>
          </a>
          <a href="#find-resources">
            <img src={biologyImage.src} alt="" />
            <span>Search the library</span>
          </a>
          <a href="#reader-tools">
            <img src={studentsImage.src} alt="" />
            <span>Reader and AI tools</span>
          </a>
          <a href="#submit-resources">
            <img src={chemistryImage.src} alt="" />
            <span>Upload a resource</span>
          </a>
          <a href="#page-map">
            <img src={mathematicsImage.src} alt="" />
            <span>Page directory</span>
          </a>
        </nav>
      </aside>

      <article class="guide-article">
        <section class="guide-section" id="how-it-works" aria-labelledby="how-title">
          <p class="eyebrow">01 / The library</p>
          <h2 id="how-title">How the library works</h2>
          <p>Study Hub publishes subject pages for the subjects in its current directory. Materials are organised by subject, resource type, and the details available for each file. Resource coverage differs by subject and class; the <a href={`${home}/subjects.html`}>Subjects and learning guide</a> explains the classes, school levels, and future university plans.</p>
          <p>The Library class shelf includes a <strong>2026 trending</strong> tile and an <strong>Unsorted files</strong> tile. Resources from the <a href="https://github.com/trustjonathan/STUDT-HUB-RESOURCES-2026">categorized resources archive</a> appear in their matching class when the filename identifies one; other files remain available in Unsorted files. Archive resources open in the Study Hub flipbook reader, and sample UNEB papers have their own year-organized folder.</p>
          <div class="guide-callout">
            <strong>From submission to library</strong>
            <p>Contributed files are reviewed before they can appear in public search. Sending a form does not publish a resource automatically.</p>
          </div>
          <p>Use the shared <a href={`${home}/library.html`}>Library</a> for catalogue search, subject filters, and live source and update information. This guide does not calculate a separate set of resource totals.</p>
        </section>

        <section class="guide-section" id="site-tour" aria-labelledby="site-tour-title">
          <p class="eyebrow">02 / A visual walkthrough</p>
          <h2 id="site-tour-title">Take a quick tour of Study Hub</h2>
          <p>These screenshots show the main places you can visit. Use the site navigation to move between them, and open the Library to browse by class.</p>
          <div class="guide-tour-grid">
            <figure class="guide-tour-card">
              <div class="guide-tour-window"><img src={`${home}/assets/library-guide/home.png`} alt="Study Hub home page with links to subjects, the library, and AI Study" loading="lazy" /></div>
              <figcaption><span>01 · Start here</span><strong>Home</strong><p>Choose a subject, explore the site, or jump into your study session.</p></figcaption>
            </figure>
            <figure class="guide-tour-card">
              <div class="guide-tour-window"><img src={`${home}/assets/library-guide/library-shelf.png`} alt="Library class shelf with navigation and class-level resource choices" loading="lazy" /></div>
              <figcaption><span>02 · Find your class</span><strong>Library</strong><p>Use the class shelf to begin browsing learning materials by level.</p></figcaption>
            </figure>
            <figure class="guide-tour-card">
              <div class="guide-tour-window"><img src={`${home}/assets/library-guide/biology-library.png`} alt="Biology subject library with revision information and resource sections" loading="lazy" /></div>
              <figcaption><span>03 · Explore a subject</span><strong>Subject library</strong><p>Browse notes and past papers when those resources are available.</p></figcaption>
            </figure>
            <figure class="guide-tour-card">
              <div class="guide-tour-window"><img src={`${home}/assets/library-guide/assistant.png`} alt="Study Assistant with suggested questions and a study prompt" loading="lazy" /></div>
              <figcaption><span>04 · Ask and learn</span><strong>AI Study</strong><p>Ask for an explanation, then check it against trusted class materials.</p></figcaption>
            </figure>
          </div>
        </section>

        <section class="guide-section" id="find-resources" aria-labelledby="find-title">
          <p class="eyebrow">03 / Browse and study</p>
          <h2 id="find-title">Search the library</h2>
          <ol class="guide-steps">
            <li><strong>Choose a subject.</strong> Use Browse subjects in the header or the directory below to open one of the published subject pages.</li>
            <li><strong>Choose a class and subject.</strong> The embedded shared Library opens with the current subject selected; use its filters to explore a different collection.</li>
            <li><strong>Search and filter.</strong> Search matches words in resource titles, filenames, subject, type, level, year, and other indexed details. Use available level or year filters to narrow the list.</li>
            <li><strong>Browse more results.</strong> The Library loads matching catalogue data from its configured public sources; use its active source and update details to understand the catalogue snapshot.</li>
            <li><strong>Preview before opening.</strong> The class Library shows a lazy first-page preview for supported PDFs and Word documents. A preview may be unavailable when the file host is offline or blocks browser access.</li>
            <li><strong>Open the file.</strong> Select a resource title or its “Open resource” link to read it in the document viewer.</li>
          </ol>
          <p>Search does not read text inside every document. A topic is searchable when the wording appears in the title, filename, or other indexed description. If a list is empty, try a shorter term and clear its filters. If the list cannot connect, try again later.</p>
        </section>

        <section class="guide-section" id="reader-tools" aria-labelledby="reader-title">
          <p class="eyebrow">05 / Read and revise</p>
          <h2 id="reader-title">Reader and AI study tools</h2>
          <p>The document reader supports page navigation, zoom, full-screen reading, text search when available, colour preferences, contents, and bookmarks. On desktop, same-subject documents stay beside the reading area; on a phone, open <strong>Related documents</strong> from the toolbar to view the full-width drawer.</p>
          <p>For PDFs, the optional AI study companion can answer questions about the visible page. It sends the page image, question, and recent conversation context to an external AI provider. Do not submit personal or confidential information, and check AI explanations against your course materials. Read the <a href={`${home}/privacy.html`}>Privacy Policy</a> for more details.</p>
          <p>Bookmarks and reading preferences are kept in the browser you use and may be removed when you clear that browser’s site data.</p>
        </section>

        <section class="guide-section" id="submit-resources" aria-labelledby="submit-title">
          <p class="eyebrow">06 / Contribute</p>
          <h2 id="submit-title">Upload a resource</h2>
          <p>While reading, use the reader’s contribution panel, or choose <strong>Submit a resource</strong> in a subject archive. Reader contributions are optional: select any number of related files (250 MB total, 50 MB each), confirm sharing rights, and submit the batch once all transfers are ready. Files remain private while they are reviewed.</p>
          <ol class="guide-steps">
            <li>Open a subject page or a supported archive.</li>
            <li>Select “Submit a resource” and enter its title and notes/past-paper category.</li>
            <li>Add level and year if known, choose the file, confirm your sharing rights, and complete the security check.</li>
            <li>Submit the completed batch for review. A curator checks suitable files before they can be added to the public library.</li>
          </ol>
          <p>Accepted types and size limits are shown in the contribution form. Do not upload material unless you have the right to share it. To request a topic instead of uploading a file, <a href="mailto:trusteth777@gmail.com?subject=Study%20Hub%20resource%20request">contact Study Hub</a>.</p>
        </section>

        <section class="guide-section" id="page-map" aria-labelledby="map-title">
          <p class="eyebrow">07 / Page directory</p>
          <h2 id="map-title">Explore subjects and site pages</h2>
          <p>Browse all {availableSubjects.length} published subject pages. Resource coverage can differ between subjects; the directory lists each subject included in the current catalogue.</p>
          <div class="guide-directory">
            {availableSubjects.map((subject) => (
              <section class="directory-row subject-directory-row" aria-label={`${subject.name} subject page`}>
                <span class="guide-directory-icon" aria-hidden="true">{subject.icon}</span>
                <div>
                  <h3>{subject.name}</h3>
                  <p>{subject.description}</p>
                  <a href={`${home}/frontend/src/html/${subject.slug}`}>Open subject page</a>
                </div>
              </section>
            ))}
          </div>
          <h3 class="guide-subheading">Additional archives</h3>
          <div class="guide-directory">
            {subjects.map((subject) => (
              <section class="directory-row" aria-label={`${subject.name} pages`}>
                <img src={subject.image.src} alt="" />
                <div>
                  <h3>{subject.name}</h3>
                  <a href={subject.hub}>Study Hub page</a>
                  <a href={subject.archive}>Resource archive</a>
                </div>
              </section>
            ))}
          </div>
          <h3 class="guide-subheading">Study Hub information</h3>
          <p>Learn <a href={`${home}/frontend/src/html/about.html`}>about Study Hub</a>, follow the <a href={`${home}/documentation.html`}>site documentation</a>, or review the <a href={`${home}/privacy.html`}>Privacy Policy</a>, <a href={`${home}/terms.html`}>Terms of Use</a>, and <a href={`${home}/copyright.html`}>Copyright Information</a>.</p>
          <p class="guide-home-link"><a href={home}>Return to the Study Hub homepage <span aria-hidden="true">→</span></a></p>
        </section>
      </article>
    </div>
  </main>
  </SiteLayout>