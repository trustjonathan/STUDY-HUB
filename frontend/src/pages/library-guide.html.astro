---
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/library-guide.css';
import biologyImage from '../assets/images/biology.jpg';
import chemistryImage from '../assets/images/chemistry.jpg';
import mathematicsImage from '../assets/images/mathematics.jpg';
import studentsImage from '../assets/images/students_studying.jpeg';
import studyImage from '../assets/images/study_pic.png';
import { availableSubjects } from '../data/availableSubjects';

const home = import.meta.env.BASE_URL.replace(/\/$/, '');
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || '';
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
const subjects = [
  {
    name: 'Biology',
    image: biologyImage,
    hub: `${home}/frontend/src/html/biology.html`,
    archive: 'https://trustjonathan.github.io/BIOLOGY/archive.html'
  },
  {
    name: 'Chemistry',
    image: chemistryImage,
    hub: `${home}/frontend/src/html/chemistry.html`,
    archive: 'https://trustjonathan.github.io/CHEMISTRY/archive.html'
  },
  {
    name: 'Mathematics',
    image: mathematicsImage,
    hub: `${home}/frontend/src/html/mathematics.html`,
    archive: 'https://trustjonathan.github.io/MATHEMATICS/archive.html'
  }
];
---

<SiteLayout
  title="Study Hub Library Guide"
  description="A detailed guide to Study Hub subjects, resource counts, navigation, searching, and submitting study materials."
>
  <Fragment slot="head">
    <meta name="study-hub-supabase-url" content={supabaseUrl}>
    <meta name="study-hub-supabase-anon-key" content={supabaseAnonKey}>
    <meta name="study-hub-resource-repository-catalog" content={`${home}/study-hub-resources-1-catalog.json`}>
  </Fragment>
  <main class="library-guide">
    <section class="guide-intro" id="guide-start" aria-labelledby="guide-title">
      <div class="guide-intro-copy">
        <p class="eyebrow">Study Hub reference</p>
        <h1 id="guide-title">The library, explained.</h1>
        <p class="guide-lede">Find resources in the four active subject libraries and learn how contributed files are reviewed before they become public.</p>
        <p class="guide-updated">Resource counts are read live from the public catalog.</p>
      </div>
      <img class="guide-hero-image" src={studentsImage.src} alt="Learners studying together" />
    </section>

    <div class="guide-layout">
      <aside class="guide-contents" aria-label="Guide contents">
        <p class="guide-contents-title">On this page</p>
        <nav>
          <a href="#how-it-works">
            <img src={studyImage.src} alt="" />
            <span>How the library works</span>
          </a>
          <a href="#site-tour">
            <img src={`${home}/assets/library-guide/library-shelf.png`} alt="" />
            <span>Visual site tour</span>
          </a>
          <a href="#resource-counts">
            <img src={mathematicsImage.src} alt="" />
            <span>Resource counts</span>
          </a>
          <a href="#find-resources">
            <img src={biologyImage.src} alt="" />
            <span>Search the library</span>
          </a>
          <a href="#reader-tools">
            <img src={studentsImage.src} alt="" />
            <span>Reader and AI tools</span>
          </a>
          <a href="#submit-resources">
            <img src={chemistryImage.src} alt="" />
            <span>Upload a resource</span>
          </a>
          <a href="#page-map">
            <img src={mathematicsImage.src} alt="" />
            <span>Page directory</span>
          </a>
        </nav>
      </aside>

      <article class="guide-article">
        <section class="guide-section" id="how-it-works" aria-labelledby="how-title">
          <p class="eyebrow">01 / The library</p>
          <h2 id="how-title">How the library works</h2>
          <p>Study Hub currently publishes learning libraries for Biology, Chemistry, Mathematics, and Physics. Materials are organised by subject, resource type, and the details available for each file. Other subject pages are under development and are not part of the public resource directory yet. The <a href={`${home}/subjects.html`}>Subjects and learning guide</a> explains the classes, school levels, and future university plans.</p>
          <p>The Library class shelf includes a <strong>2026 trending</strong> tile and an <strong>Unsorted files</strong> tile. Resources from the <a href="https://github.com/trustjonathan/STUDT-HUB-RESOURCES-2026">categorized resources archive</a> appear in their matching class when the filename identifies one; other files remain available in Unsorted files. Archive resources open in the Study Hub flipbook reader, and sample UNEB papers have their own year-organized folder.</p>
          <div class="guide-callout">
            <strong>From submission to library</strong>
            <p>Contributed files are reviewed before they can appear in public search. Sending a form does not publish a resource automatically.</p>
          </div>
          <p>The resource-count table below summarises the published library by subject and category. Counts update while this page is open; a temporary connection problem may prevent the latest totals from loading.</p>
        </section>

        <section class="guide-section" id="site-tour" aria-labelledby="site-tour-title">
          <p class="eyebrow">02 / A visual walkthrough</p>
          <h2 id="site-tour-title">Take a quick tour of Study Hub</h2>
          <p>These screenshots show the main places you can visit. Use the site navigation to move between them, and open the Library to browse by class.</p>
          <div class="guide-tour-grid">
            <figure class="guide-tour-card">
              <div class="guide-tour-window"><img src={`${home}/assets/library-guide/home.png`} alt="Study Hub home page with links to subjects, the library, and AI Study" loading="lazy" /></div>
              <figcaption><span>01 · Start here</span><strong>Home</strong><p>Choose a subject, explore the site, or jump into your study session.</p></figcaption>
            </figure>
            <figure class="guide-tour-card">
              <div class="guide-tour-window"><img src={`${home}/assets/library-guide/library-shelf.png`} alt="Library class shelf with navigation and class-level resource choices" loading="lazy" /></div>
              <figcaption><span>02 · Find your class</span><strong>Library</strong><p>Use the class shelf to begin browsing learning materials by level.</p></figcaption>
            </figure>
            <figure class="guide-tour-card">
              <div class="guide-tour-window"><img src={`${home}/assets/library-guide/biology-library.png`} alt="Biology subject library with revision information and resource sections" loading="lazy" /></div>
              <figcaption><span>03 · Explore a subject</span><strong>Subject library</strong><p>Browse notes and past papers when those resources are available.</p></figcaption>
            </figure>
            <figure class="guide-tour-card">
              <div class="guide-tour-window"><img src={`${home}/assets/library-guide/assistant.png`} alt="Study Assistant with suggested questions and a study prompt" loading="lazy" /></div>
              <figcaption><span>04 · Ask and learn</span><strong>AI Study</strong><p>Ask for an explanation, then check it against trusted class materials.</p></figcaption>
            </figure>
          </div>
        </section>

        <section class="guide-section" id="resource-counts" aria-labelledby="counts-title">
          <p class="eyebrow">03 / The collection</p>
          <h2 id="counts-title">How many resources are available?</h2>
          <p>The total combines files from the full subject catalog with resources from the Study Hub subject libraries. Counts refresh when this page opens and periodically while it remains open.</p>
          <div class="guide-table-wrap">
            <table>
              <caption>Library resources across all catalog subjects, grouped by category</caption>
              <thead>
                <tr><th scope="col">Subject</th><th scope="col">Notes</th><th scope="col">Past papers</th><th scope="col">Other / uncategorized</th><th scope="col">Total</th></tr>
              </thead>
              <tbody data-resource-counts>
                <tr><td colspan="5" role="status">Loading all-subject library counts…</td></tr>
              </tbody>
              <tfoot data-resource-totals>
                <tr><th scope="row">All library resources</th><td>—</td><td>—</td><td>—</td><td>—</td></tr>
              </tfoot>
            </table>
          </div>
          <div class="guide-count-controls">
            <p class="guide-count-status" data-resource-count-status role="status" aria-live="polite">Counting files from all library subjects…</p>
            <button class="guide-count-refresh" type="button" data-resource-count-refresh>Refresh counts</button>
          </div>
          <template data-subject-rows>
                {availableSubjects.map((subject) => (
                  <tr>
                    <th
                      scope="row"
                      data-subject-name={subject.slug}
                      data-subject-aliases={[subject.storageFolder, ...subject.folderAliases].join(',')}
                    >{subject.name}</th>
                    <td data-count-category="notes">0</td>
                    <td data-count-category="papers">0</td>
                    <td data-count-category="other">0</td>
                    <td><strong data-count-category="total">0</strong></td>
                  </tr>
                ))}
          </template>
        </section>

        <section class="guide-section" id="find-resources" aria-labelledby="find-title">
          <p class="eyebrow">04 / Browse and study</p>
          <h2 id="find-title">Search the library</h2>
          <ol class="guide-steps">
            <li><strong>Choose a subject.</strong> Use Browse subjects in the header or the directory below to open one of the four available subject libraries.</li>
            <li><strong>Choose a collection.</strong> Subject pages provide separate study-note and recently added sections; past papers and other resources appear where they are available.</li>
            <li><strong>Search and filter.</strong> Search matches words in resource titles, filenames, subject, type, level, year, and other indexed details. Use available level or year filters to narrow the list.</li>
            <li><strong>Load more results.</strong> Recent and notes collections scroll independently and request additional catalog pages as you continue. Search can also check the full matching collection.</li>
            <li><strong>Preview before opening.</strong> The class Library shows a lazy first-page preview for supported PDFs and Word documents. A preview may be unavailable when the file host is offline or blocks browser access.</li>
            <li><strong>Open the file.</strong> Select a resource title or its “Open resource” link to read it in the document viewer.</li>
          </ol>
          <p>Search does not read text inside every document. A topic is searchable when the wording appears in the title, filename, or other indexed description. If a list is empty, try a shorter term and clear its filters. If the list cannot connect, try again later.</p>
        </section>

        <section class="guide-section" id="reader-tools" aria-labelledby="reader-title">
          <p class="eyebrow">05 / Read and revise</p>
          <h2 id="reader-title">Reader and AI study tools</h2>
          <p>The document reader supports page navigation, zoom, full-screen reading, text search when available, colour preferences, contents, and bookmarks. On desktop, same-subject documents stay beside the reading area; on a phone, open <strong>Related documents</strong> from the toolbar to view the full-width drawer.</p>
          <p>For PDFs, the optional AI study companion can answer questions about the visible page. It sends the page image, question, and recent conversation context to an external AI provider. Do not submit personal or confidential information, and check AI explanations against your course materials. Read the <a href={`${home}/privacy.html`}>Privacy Policy</a> for more details.</p>
          <p>Bookmarks and reading preferences are kept in the browser you use and may be removed when you clear that browser’s site data.</p>
        </section>

        <section class="guide-section" id="submit-resources" aria-labelledby="submit-title">
          <p class="eyebrow">06 / Contribute</p>
          <h2 id="submit-title">Upload a resource</h2>
          <p>While reading, use the reader’s contribution panel, or choose <strong>Submit a resource</strong> in a subject archive. Reader contributions are optional: select any number of related files (250 MB total, 50 MB each), confirm sharing rights, and submit the batch once all transfers are ready. Files remain private while they are reviewed.</p>
          <ol class="guide-steps">
            <li>Open a subject page or a supported archive.</li>
            <li>Select “Submit a resource” and enter its title and notes/past-paper category.</li>
            <li>Add level and year if known, choose the file, confirm your sharing rights, and complete the security check.</li>
            <li>Submit the completed batch for review. A curator checks suitable files before they can be added to the public library.</li>
          </ol>
          <p>Accepted types and size limits are shown in the contribution form. Do not upload material unless you have the right to share it. To request a topic instead of uploading a file, <a href="mailto:trusteth777@gmail.com?subject=Study%20Hub%20resource%20request">contact Study Hub</a>.</p>
        </section>

        <section class="guide-section" id="page-map" aria-labelledby="map-title">
          <p class="eyebrow">07 / Page directory</p>
          <h2 id="map-title">Explore subjects and site pages</h2>
          <p>Browse the four subject libraries currently available. More subjects are being prepared; see <a href={`${home}/under-development.html`}>Pages under development</a> for the current status.</p>
          <div class="guide-directory">
            {availableSubjects.map((subject) => (
              <section class="directory-row subject-directory-row" aria-label={`${subject.name} subject page`}>
                <span class="guide-directory-icon" aria-hidden="true">{subject.icon}</span>
                <div>
                  <h3>{subject.name}</h3>
                  <p>{subject.description}</p>
                  <a href={`${home}/frontend/src/html/${subject.slug}.html`}>Open subject page</a>
                </div>
              </section>
            ))}
          </div>
          <h3 class="guide-subheading">Additional archives</h3>
          <div class="guide-directory">
            {subjects.map((subject) => (
              <section class="directory-row" aria-label={`${subject.name} pages`}>
                <img src={subject.image.src} alt="" />
                <div>
                  <h3>{subject.name}</h3>
                  <a href={subject.hub}>Study Hub page</a>
                  <a href={subject.archive}>Resource archive</a>
                </div>
              </section>
            ))}
          </div>
          <h3 class="guide-subheading">Study Hub information</h3>
          <p>Learn <a href={`${home}/frontend/src/html/about.html`}>about Study Hub</a>, follow the <a href={`${home}/documentation.html`}>site documentation</a>, or review the <a href={`${home}/privacy.html`}>Privacy Policy</a>, <a href={`${home}/terms.html`}>Terms of Use</a>, and <a href={`${home}/copyright.html`}>Copyright Information</a>.</p>
          <p class="guide-home-link"><a href={home}>Return to the Study Hub homepage <span aria-hidden="true">→</span></a></p>
        </section>
      </article>
    </div>
  </main>
</SiteLayout>

<script>
  type SubjectCounts = { notes: number; papers: number; other: number; total: number };
  type ResourceCategory = 'notes' | 'papers' | 'other';

  const tableBody = document.querySelector<HTMLTableSectionElement>('[data-resource-counts]');
  const totalsFooter = document.querySelector<HTMLTableSectionElement>('[data-resource-totals]');
  const status = document.querySelector<HTMLParagraphElement>('[data-resource-count-status]');
  const refreshButton = document.querySelector<HTMLButtonElement>('[data-resource-count-refresh]');
  const supabaseUrl = document.querySelector<HTMLMetaElement>('meta[name="study-hub-supabase-url"]')?.content.replace(/\/+$/, '');
  const anonKey = document.querySelector<HTMLMetaElement>('meta[name="study-hub-supabase-anon-key"]')?.content;
  const resourceRepositoryCatalogUrl = document.querySelector<HTMLMetaElement>('meta[name="study-hub-resource-repository-catalog"]')?.content;
  const subjectTemplate = document.querySelector<HTMLTemplateElement>('template[data-subject-rows]');
  const pageSize = 1000;
  let isLoading = false;

  const formatCount = (count: number) => count.toLocaleString();

  function normalizeSubject(subject: string) {
    const normalized = subject.trim().replace(/([a-z0-9])([A-Z])/g, '$1 $2').replace(/[_-]+/g, ' ');
    if (!normalized || normalized.toLowerCase() === 'all subjects') return 'General';
    return normalized.split(/\s+/).map((word) => (
      word.length <= 3 ? word.toUpperCase() : word.charAt(0).toUpperCase() + word.slice(1)
    )).join(' ');
  }

  function makeSubjectKeys() {
    const keys = new Map<string, string>();
    for (const row of subjectTemplate?.content.querySelectorAll<HTMLTableRowElement>('[data-subject-name]') || []) {
      const slug = row.dataset.subjectName;
      const label = row.querySelector<HTMLElement>('[data-subject-name]')?.textContent?.trim();
      if (!slug || !label) continue;
      keys.set(slug.toLowerCase(), label);
      for (const alias of (row.dataset.subjectAliases || '').split(',')) {
        if (alias.trim()) keys.set(alias.trim().toLowerCase(), label);
      }
    }
    return keys;
  }

  function addResourceCount(counts: Map<string, SubjectCounts>, subject: string, resourceType: string, subjectKeys: Map<string, string>) {
    const rawSubject = subject.trim() || 'General';
    const label = subjectKeys.get(rawSubject.toLowerCase()) || normalizeSubject(rawSubject);
    const type = resourceType.toLowerCase();
    const category: ResourceCategory = type.includes('paper')
      ? 'papers'
      : type.includes('note') || type.includes('lesson')
        ? 'notes'
        : 'other';
    const subjectCount = counts.get(label) || { notes: 0, papers: 0, other: 0, total: 0 };
    subjectCount[category] += 1;
    subjectCount.total += 1;
    counts.set(label, subjectCount);
  }

  async function fetchResourceRepositoryCounts(subjectKeys: Map<string, string>) {
    if (!resourceRepositoryCatalogUrl) throw new Error('Resource repository catalog URL is not configured.');
    const response = await fetch(resourceRepositoryCatalogUrl);
    if (!response.ok) throw new Error(`Resource repository catalog returned HTTP ${response.status}.`);
    const data = await response.json();
    if (!Array.isArray(data?.items)) throw new Error('Resource repository catalog returned an invalid list.');

    const counts = new Map<string, SubjectCounts>();
    let fetched = 0;
    for (const item of data.items) {
      if (typeof item?.url !== 'string' || !item.url.trim()) continue;
      addResourceCount(counts, String(item.subject || 'General'), String(item.type || ''), subjectKeys);
      fetched += 1;
    }
    return { counts, fetched };
  }

  async function fetchStudyHubCounts(subjectKeys: Map<string, string>) {
    if (!supabaseUrl || !anonKey) throw new Error('Study Hub subject catalog is not configured.');
    const counts = new Map<string, SubjectCounts>();
    let offset = 0;
    let fetched = 0;
    const headers: Record<string, string> = { apikey: anonKey };
    if (anonKey.startsWith('eyJ')) headers.Authorization = `Bearer ${anonKey}`;

    for (;;) {
      const endpoint = new URL(`${supabaseUrl}/rest/v1/study_hub_resources`);
      endpoint.searchParams.set('select', 'subject,category');
      endpoint.searchParams.set('order', 'subject.asc,category.asc');
      endpoint.searchParams.set('limit', String(pageSize));
      endpoint.searchParams.set('offset', String(offset));

      const response = await fetch(endpoint, { headers });
      if (!response.ok) throw new Error(`Study Hub catalog returned HTTP ${response.status}.`);
      const rows = await response.json();
      if (!Array.isArray(rows)) throw new Error('Study Hub catalog returned an invalid list.');

      for (const resource of rows) {
        addResourceCount(counts, String(resource.subject || 'General'), String(resource.category || ''), subjectKeys);
      }
      fetched += rows.length;
      if (rows.length < pageSize) break;
      offset += rows.length;
    }
    return { counts, fetched };
  }

  function renderResourceCounts(counts: Map<string, SubjectCounts>) {
    if (!tableBody || !totalsFooter) return { subjectCount: 0, totals: { notes: 0, papers: 0, other: 0, total: 0 } };
    const fragment = document.createDocumentFragment();
    const totals: SubjectCounts = { notes: 0, papers: 0, other: 0, total: 0 };
    const subjects = Array.from(counts.entries()).sort(([a], [b]) => a.localeCompare(b));

    for (const [subject, subjectCount] of subjects) {
      const row = document.createElement('tr');
      const name = document.createElement('th');
      name.scope = 'row';
      name.textContent = subject;
      row.appendChild(name);
      for (const category of ['notes', 'papers', 'other'] as const) {
        const cell = document.createElement('td');
        cell.textContent = formatCount(subjectCount[category]);
        row.appendChild(cell);
        totals[category] += subjectCount[category];
      }
      const total = document.createElement('td');
      const totalValue = document.createElement('strong');
      totalValue.textContent = formatCount(subjectCount.total);
      total.appendChild(totalValue);
      row.appendChild(total);
      totals.total += subjectCount.total;
      fragment.appendChild(row);
    }

    tableBody.replaceChildren(fragment);
    totalsFooter.querySelectorAll('td').forEach((cell, index) => {
      cell.textContent = formatCount([totals.notes, totals.papers, totals.other, totals.total][index]);
    });
    return { subjectCount: subjects.length, totals };
  }

  function showError(message: string) {
    if (status) status.textContent = message;
    if (tableBody) {
      tableBody.replaceChildren();
      const row = document.createElement('tr');
      const cell = document.createElement('td');
      cell.colSpan = 5;
      cell.setAttribute('role', 'alert');
      cell.textContent = message;
      row.appendChild(cell);
      tableBody.appendChild(row);
    }
    totalsFooter?.querySelectorAll('td').forEach((cell) => { cell.textContent = '—'; });
  }

  async function loadResourceCounts() {
    if (isLoading || !tableBody || !totalsFooter || !subjectTemplate || !refreshButton) return;
    isLoading = true;
    refreshButton.disabled = true;
    if (status) status.textContent = 'Counting files from all library subjects…';

    try {
      const subjectKeys = makeSubjectKeys();
      const [resourceRepositoryResult, studyHubResult] = await Promise.allSettled([
        fetchResourceRepositoryCounts(subjectKeys),
        fetchStudyHubCounts(subjectKeys),
      ]);
      const failures: string[] = [];
      const resourceRepository = resourceRepositoryResult.status === 'fulfilled' ? resourceRepositoryResult.value : null;
      const studyHub = studyHubResult.status === 'fulfilled' ? studyHubResult.value : null;
      if (resourceRepositoryResult.status === 'rejected') {
        failures.push(`Resource repository: ${resourceRepositoryResult.reason instanceof Error ? resourceRepositoryResult.reason.message : 'request failed'}`);
      }
      if (studyHubResult.status === 'rejected') {
        failures.push(`Study Hub: ${studyHubResult.reason instanceof Error ? studyHubResult.reason.message : 'request failed'}`);
      }
      if (!resourceRepository && !studyHub) throw new Error(failures.join(' '));

      const counts = new Map<string, SubjectCounts>();
      for (const sourceCounts of [resourceRepository?.counts, studyHub?.counts]) {
        sourceCounts?.forEach((sourceCount, subject) => {
          const combined = counts.get(subject) || { notes: 0, papers: 0, other: 0, total: 0 };
          combined.notes += sourceCount.notes;
          combined.papers += sourceCount.papers;
          combined.other += sourceCount.other;
          combined.total += sourceCount.total;
          counts.set(subject, combined);
        });
      }

      const { subjectCount, totals } = renderResourceCounts(counts);
      const updatedAt = new Date().toLocaleTimeString();
      if (status) {
        status.textContent = failures.length
          ? `Partial count: ${formatCount(totals.total)} resources across ${subjectCount} subject groups. ${failures.join(' ')} Last updated ${updatedAt}.`
          : `Counted ${formatCount(totals.total)} resources across ${subjectCount} subject groups: ${formatCount(resourceRepository?.fetched || 0)} resource repository files and ${formatCount(studyHub?.fetched || 0)} Study Hub files. Last updated ${updatedAt}.`;
      }
    } catch (error) {
      console.error('Unable to refresh all-subject Study Hub resource counts:', error);
      showError('Could not load library resource counts. Check your connection and try again.');
    } finally {
      isLoading = false;
      refreshButton.disabled = false;
    }
  }

  refreshButton?.addEventListener('click', loadResourceCounts);
  void loadResourceCounts();
  window.setInterval(() => {
    if (document.visibilityState === 'visible') void loadResourceCounts();
  }, 60_000);
</script>