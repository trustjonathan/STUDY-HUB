---
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/library-guide.css';
import biologyImage from '../assets/images/biology.jpg';
import chemistryImage from '../assets/images/chemistry.jpg';
import mathematicsImage from '../assets/images/mathematics.jpg';
import studentsImage from '../assets/images/students_studying.jpeg';
import studyImage from '../assets/images/study_pic.png';
import subjectCatalog from '../data/subjects.json';

const home = import.meta.env.BASE_URL.replace(/\/$/, '');
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || '';
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
const subjects = [
  {
    name: 'Biology',
    image: biologyImage,
    hub: `${home}/frontend/src/html/biology.html`,
    archive: 'https://trustjonathan.github.io/BIOLOGY/archive.html'
  },
  {
    name: 'Chemistry',
    image: chemistryImage,
    hub: `${home}/frontend/src/html/chemistry.html`,
    archive: 'https://trustjonathan.github.io/CHEMISTRY/archive.html'
  },
  {
    name: 'Mathematics',
    image: mathematicsImage,
    hub: `${home}/frontend/src/html/mathematics.html`,
    archive: 'https://trustjonathan.github.io/MATHEMATICS/archive.html'
  }
];
---

<SiteLayout
  title="Study Hub Library Guide"
  description="A detailed guide to Study Hub subjects, resource counts, navigation, searching, and submitting study materials."
>
  <Fragment slot="head">
    <meta name="study-hub-supabase-url" content={supabaseUrl}>
    <meta name="study-hub-supabase-anon-key" content={supabaseAnonKey}>
  </Fragment>
  <main class="library-guide">
    <section class="guide-intro" id="guide-start" aria-labelledby="guide-title">
      <div class="guide-intro-copy">
        <p class="eyebrow">Study Hub reference</p>
        <h1 id="guide-title">The library, explained.</h1>
        <p class="guide-lede">Find the right subject page, browse the shared collection, and learn how contributed files are reviewed before they become public.</p>
        <p class="guide-updated">Resource counts are read live from the public catalog.</p>
      </div>
      <img class="guide-hero-image" src={studentsImage.src} alt="Learners studying together" />
    </section>

    <div class="guide-layout">
      <aside class="guide-contents" aria-label="Guide contents">
        <p class="guide-contents-title">On this page</p>
        <nav>
          <a href="#how-it-works">
            <img src={studyImage.src} alt="" />
            <span>How the library works</span>
          </a>
          <a href="#resource-counts">
            <img src={mathematicsImage.src} alt="" />
            <span>Resource counts</span>
          </a>
          <a href="#find-resources">
            <img src={biologyImage.src} alt="" />
            <span>Find and open files</span>
          </a>
          <a href="#submit-resources">
            <img src={chemistryImage.src} alt="" />
            <span>Upload a resource</span>
          </a>
          <a href="#page-map">
            <img src={studentsImage.src} alt="" />
            <span>Page directory</span>
          </a>
        </nav>
      </aside>

      <article class="guide-article">
        <section class="guide-section" id="how-it-works" aria-labelledby="how-title">
          <p class="eyebrow">01 / The system</p>
          <h2 id="how-title">How the library works</h2>
          <p>Study Hub keeps resource files and their searchable descriptions in a shared library. A file lives in Supabase Storage; a matching record in the <code>study_hub_resources</code> catalog supplies its subject, type, title, level, year, and storage location.</p>
          <div class="guide-callout">
            <strong>Public library</strong>
            <p>Only approved files in the public <code>study-hub-resources</code> bucket, with catalog entries, appear in the browse lists.</p>
          </div>
          <p>Subject pages and this count table read the public catalog directly from Supabase. An uploaded file appears after its public catalog entry exists.</p>
          <p>New submissions are separate: they are placed in private submission storage and marked pending. A curator checks the file and rights confirmation, then publishes approved material to the public library. Sending a form does not immediately add a public result.</p>
        </section>

        <section class="guide-section" id="resource-counts" aria-labelledby="counts-title">
          <p class="eyebrow">02 / The collection</p>
          <h2 id="counts-title">How many resources are available?</h2>
          <p>Counts below are refreshed from the published catalog when this page opens and periodically while it remains open. Newly published resources are included automatically.</p>
          <div class="guide-table-wrap">
            <table>
              <caption>Published catalog records by subject and category</caption>
              <thead>
                <tr><th scope="col">Subject</th><th scope="col">Notes</th><th scope="col">Past papers</th><th scope="col">Other / uncategorized</th><th scope="col">Total</th></tr>
              </thead>
              <tbody data-resource-counts>
                <tr><td colspan="5" role="status">Loading live resource counts…</td></tr>
              </tbody>
              <tfoot data-resource-totals>
                <tr><th scope="row">All subjects</th><td>—</td><td>—</td><td>—</td><td>—</td></tr>
              </tfoot>
            </table>
          </div>
          <div class="guide-count-controls">
            <p class="guide-count-status" data-resource-count-status role="status" aria-live="polite">Connecting to the public resource catalog…</p>
            <button class="guide-count-refresh" type="button" data-resource-count-refresh>Refresh counts</button>
          </div>
          <template data-subject-rows>
                {subjectCatalog.map((subject) => (
                  <tr>
                    <th
                      scope="row"
                      data-subject-name={subject.slug}
                      data-subject-aliases={[subject.storageFolder, ...subject.folderAliases].join(',')}
                    >{subject.name}</th>
                    <td data-count-category="notes">0</td>
                    <td data-count-category="papers">0</td>
                    <td data-count-category="other">0</td>
                    <td><strong data-count-category="total">0</strong></td>
                  </tr>
                ))}
          </template>
        </section>

        <section class="guide-section" id="find-resources" aria-labelledby="find-title">
          <p class="eyebrow">03 / Browse and study</p>
          <h2 id="find-title">Find and open files</h2>
          <ol class="guide-steps">
            <li><strong>Choose a subject.</strong> Use the header’s subject menu or the directory below to open Biology, Chemistry, or Mathematics.</li>
            <li><strong>Choose notes or past papers.</strong> Subject pages offer separate lists for each type; archive pages combine the collection with category tabs.</li>
            <li><strong>Search and filter.</strong> Search titles or topics, narrow by study level, and sort by title, year, or date where the page offers those controls.</li>
            <li><strong>Open the file.</strong> Select a resource title or its “Open resource” link. The dedicated reader keeps its toolbar and contribution panel in place while you scroll through the document.</li>
          </ol>
          <p>Some pages show an initial set of results with a “Load more” control. If a list is empty, clear its search and level filters first. A connection or configuration message means the page could not reach its data source; a “no published resources” message means no public rows matched that page’s subject and category.</p>
        </section>

        <section class="guide-section" id="submit-resources" aria-labelledby="submit-title">
          <p class="eyebrow">04 / Contribute</p>
          <h2 id="submit-title">Upload a resource</h2>
          <p>While reading, use the reader’s contribution panel, or choose <strong>Submit a resource</strong> in a subject archive. Reader contributions are optional: select up to 20 related files (250 MB total, 50 MB each), confirm sharing rights, and complete verification. Files stage privately in parallel; submit the batch when all transfers are ready.</p>
          <ol class="guide-steps">
            <li>Open the Biology, Chemistry, or Mathematics archive below.</li>
            <li>Select “Submit a resource” and enter its title and notes/past-paper category.</li>
            <li>Add level and year if known, choose the file, confirm your sharing rights, and complete the security check.</li>
            <li>Submit for review. Staged files are moved together into the private <code>study-hub-contributions/contribution/</code> inbox. A curator sorts suitable files into the relevant library folders; uploads are never published automatically.</li>
          </ol>
          <p>Accepted file types are PDF, Word, RTF, and plain text. Completed staged files remain available if you leave the reader; to resume an interrupted file, return in the same browser and reselect the original file. Unsubmitted staging expires after 24 hours. Do not upload material unless you have the right to distribute it. To request a topic instead of uploading a file, <a href="mailto:trusteth777@gmail.com?subject=Study%20Hub%20resource%20request">contact Study Hub</a>.</p>
          <p>When reading, open <strong>Contents and bookmarks</strong> for document navigation and saved positions. Reading colors can be changed from the toolbar, and preferences are kept in the current browser.</p>
        </section>

        <section class="guide-section" id="page-map" aria-labelledby="map-title">
          <p class="eyebrow">05 / Page directory</p>
          <h2 id="map-title">Navigate the Study Hub</h2>
          <p>Use the top navigation to return home, jump to the subject overview, or open a subject/archive submenu. These links take you directly to each destination:</p>
          <div class="guide-directory">
            {subjects.map((subject) => (
              <section class="directory-row" aria-label={`${subject.name} pages`}>
                <img src={subject.image.src} alt="" />
                <div>
                  <h3>{subject.name}</h3>
                  <a href={subject.hub}>Study Hub page</a>
                  <a href={subject.archive}>Resource archive</a>
                </div>
              </section>
            ))}
          </div>
          <p class="guide-home-link"><a href={home}>Return to the Study Hub homepage <span aria-hidden="true">→</span></a></p>
        </section>
      </article>
    </div>
  </main>
</SiteLayout>

<script>
  type SubjectCounts = { notes: number; papers: number; other: number; total: number };
  type ResourceCategory = 'notes' | 'papers' | 'other';

  const tableBody = document.querySelector<HTMLTableSectionElement>('[data-resource-counts]');
  const totalsFooter = document.querySelector<HTMLTableSectionElement>('[data-resource-totals]');
  const status = document.querySelector<HTMLParagraphElement>('[data-resource-count-status]');
  const refreshButton = document.querySelector<HTMLButtonElement>('[data-resource-count-refresh]');
  const supabaseUrl = document.querySelector<HTMLMetaElement>('meta[name="study-hub-supabase-url"]')?.content.replace(/\/+$/, '');
  const anonKey = document.querySelector<HTMLMetaElement>('meta[name="study-hub-supabase-anon-key"]')?.content;
  const subjectTemplate = document.querySelector<HTMLTemplateElement>('template[data-subject-rows]');
  const pageSize = 1000;
  let isLoading = false;

  function showError(message: string) {
    if (status) status.textContent = message;
    if (tableBody) {
      tableBody.replaceChildren();
      const row = document.createElement('tr');
      const cell = document.createElement('td');
      cell.colSpan = 5;
      cell.setAttribute('role', 'alert');
      cell.textContent = message;
      row.appendChild(cell);
      tableBody.appendChild(row);
    }
    totalsFooter?.querySelectorAll('td').forEach((cell) => { cell.textContent = '—'; });
  }

  async function loadResourceCounts() {
    if (isLoading || !tableBody || !totalsFooter || !subjectTemplate || !refreshButton) return;
    if (!supabaseUrl || !anonKey) {
      showError('Live counts are unavailable: configure the public Supabase URL and anon key.');
      return;
    }

    isLoading = true;
    refreshButton.disabled = true;
    if (status) status.textContent = 'Refreshing resource counts…';

    try {
      const counts = new Map<string, SubjectCounts>();
      const subjectKeys = new Map();
      for (const row of subjectTemplate.content.querySelectorAll<HTMLTableRowElement>('[data-subject-name]')) {
        const slug = row.dataset.subjectName;
        subjectKeys.set(slug, slug);
        for (const alias of (row.dataset.subjectAliases || '').split(',')) {
          if (alias) subjectKeys.set(alias.trim().toLowerCase(), slug);
        }
      }
      let offset = 0;
      let fetched = 0;
      const headers: Record<string, string> = { apikey: anonKey };
      if (anonKey.startsWith('eyJ')) headers.Authorization = `Bearer ${anonKey}`;

      for (;;) {
        const endpoint = new URL(`${supabaseUrl}/rest/v1/study_hub_resources`);
        endpoint.searchParams.set('select', 'subject,category');
        endpoint.searchParams.set('order', 'subject.asc,category.asc');
        endpoint.searchParams.set('limit', String(pageSize));
        endpoint.searchParams.set('offset', String(offset));

        const response = await fetch(endpoint, { headers });
        if (!response.ok) throw new Error(`Supabase returned HTTP ${response.status}.`);
        const rows = await response.json();
        if (!Array.isArray(rows)) throw new Error('Supabase returned an invalid resource catalog.');

        for (const resource of rows) {
          const subjectKey = String(resource.subject || '').trim().toLowerCase();
          const key = subjectKeys.get(subjectKey);
          if (!key) continue;
          const category: ResourceCategory = resource.category === 'notes' || resource.category === 'papers'
            ? resource.category
            : 'other';
          const subjectCount = counts.get(key) || { notes: 0, papers: 0, other: 0, total: 0 };
          subjectCount[category] += 1;
          subjectCount.total += 1;
          counts.set(key, subjectCount);
        }

        fetched += rows.length;
        if (rows.length < pageSize) break;
        offset += rows.length;
      }

      const fragment = document.importNode(subjectTemplate.content, true);
      const subjectRows = Array.from(fragment.querySelectorAll<HTMLTableRowElement>('tr'));
      let totalNotes = 0;
      let totalPapers = 0;
      let totalOther = 0;
      let totalResources = 0;

      for (const row of subjectRows) {
        const subjectKey = row.querySelector<HTMLTableCellElement>('[data-subject-name]')?.dataset.subjectName;
        const subjectCount = counts.get(subjectKey || '') || { notes: 0, papers: 0, other: 0, total: 0 };
        for (const category of ['notes', 'papers', 'other', 'total'] as const) {
          const cell = row.querySelector<HTMLTableCellElement>(`[data-count-category="${category}"]`);
          if (cell) cell.textContent = String(subjectCount[category]);
        }
        totalNotes += subjectCount.notes;
        totalPapers += subjectCount.papers;
        totalOther += subjectCount.other;
        totalResources += subjectCount.total;
      }

      tableBody.replaceChildren(fragment);
      totalsFooter.querySelectorAll('td').forEach((cell, index) => {
        cell.textContent = String([totalNotes, totalPapers, totalOther, totalResources][index]);
      });
      if (status) {
        status.textContent = `Showing counts for ${subjectRows.length} subjects from ${fetched} catalog records. Last updated ${new Date().toLocaleTimeString()}.`;
      }
    } catch (error) {
      console.error('Unable to refresh Study Hub resource counts:', error);
      showError('Could not load live resource counts. Check your connection and Supabase configuration, then retry.');
    } finally {
      isLoading = false;
      refreshButton.disabled = false;
    }
  }

  refreshButton?.addEventListener('click', loadResourceCounts);
  void loadResourceCounts();
  window.setInterval(() => {
    if (document.visibilityState === 'visible') void loadResourceCounts();
  }, 60_000);
</script>