---
import SiteLayout from '../../layouts/SiteLayout.astro';
import AdminWorkspace from '../../components/AdminWorkspace';
import '../../styles/document-payments.css';
import '../../styles/admin-workspace.css';
import '../../styles/admin-performance.css';

const apiUrl = (import.meta.env.PUBLIC_STUDY_HUB_API_URL || '').trim();
---

<SiteLayout title="Admin dashboard | Study Hub" description="Study Hub administrator dashboard for payment verification and resource uploads.">
  <AdminWorkspace client:load apiUrl={apiUrl} />
</SiteLayout>
