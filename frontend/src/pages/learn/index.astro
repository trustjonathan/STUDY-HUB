---
import SiteLayout from '../../layouts/SiteLayout.astro';
import DynamicLessonViewer from '../../components/DynamicLessonViewer';
import { lessonTopics } from '../../data/lessonTopics';
import '../../styles/learn.css';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

// New topics arrive as /learn?topic=glycolysis and are generated on demand.
const requestedTopic = Astro.url.searchParams.get('topic')?.trim() || '';
const subjects = [...new Set(lessonTopics.map((topic) => topic.subject))].sort();
---

<SiteLayout title="AI Study Guides – Study Hub" description="Open any topic to instantly generate an AI study guide with clear explanations and exam-focused notes.">
  <main class="learn-index">
    {requestedTopic ? (
      <div class="lesson-page">
        <nav class="lesson-back">
          <a href={`${base}learn.html`}>← Back to AI Library</a>
        </nav>
        <header class="lesson-header">
          <span class="lesson-subject">On-demand guide</span>
          <h1 class="capitalize">{requestedTopic}</h1>
          <p class="lesson-tagline">A focused, exam-useful breakdown generated on demand.</p>
        </header>
        <DynamicLessonViewer client:load topic={requestedTopic} />
        <footer class="lesson-footer">
          Powered by Study Hub &amp; the Gemini AI Engine. Always check explanations against your notes and teacher’s guidance.
        </footer>
      </div>
    ) : (
      <>
        <header class="learn-index-header">
          <p class="eyebrow">Instant AI guides</p>
          <h1>Science &amp; Maths Digital Library</h1>
          <p>
            Pick a topic below, or type any topic to generate a brand-new study guide on demand. Each guide
            is written with an introduction, core principles, and real-world importance.
          </p>
        </header>

        <form class="learn-search" method="get" action={`${base}learn.html`} role="search">
          <label class="sr-only" for="learn-topic-input">Topic to generate</label>
          <input
            id="learn-topic-input"
            name="topic"
            type="search"
            placeholder="Type any topic, e.g. glycolysis, osmosis, matrices…"
            autocomplete="off"
          />
          <button type="submit">Generate guide</button>
        </form>

        <div class="learn-catalogue-search" role="search">
          <label for="learn-catalogue-search">Search all subjects and topics</label>
          <input id="learn-catalogue-search" type="search" placeholder="Search Biology, quadratic equations, map reading…" autocomplete="off" />
          <p id="learn-search-status" role="status" aria-live="polite">{lessonTopics.length} topics across {subjects.length} subjects</p>
        </div>

        {subjects.map((subject) => (
          <section class="learn-subject" data-learn-subject={subject.toLowerCase()}>
            <h2>{subject}</h2>
            <div class="learn-topic-grid">
              {lessonTopics.filter((topic) => topic.subject === subject).map((topic) => (
                <a class="learn-topic-card" href={`${base}learn/${topic.slug}.html`} data-learn-topic={`${topic.title} ${topic.subject}`.toLowerCase()}>
                  <h3>{topic.title}</h3>
                  <span>Instant AI guide &amp; study notes →</span>
                </a>
              ))}
            </div>
          </section>
        ))}
      </>
    )}
  </main>
</SiteLayout>

<script>
  const search = document.querySelector<HTMLInputElement>('#learn-catalogue-search');
  const status = document.querySelector<HTMLElement>('#learn-search-status');
  const sections = [...document.querySelectorAll<HTMLElement>('.learn-subject')];
  const topics = [...document.querySelectorAll<HTMLElement>('.learn-topic-card')];

  search?.addEventListener('input', () => {
    const query = search.value.trim().toLowerCase();
    let matches = 0;
    let visibleSubjects = 0;

    for (const section of sections) {
      let sectionMatches = 0;
      for (const card of section.querySelectorAll<HTMLElement>('.learn-topic-card')) {
        const match = !query || (card.dataset.learnTopic || '').includes(query);
        card.hidden = !match;
        if (match) sectionMatches += 1;
      }
      section.hidden = sectionMatches === 0;
      if (sectionMatches) visibleSubjects += 1;
      matches += sectionMatches;
    }

    if (status) {
      status.textContent = query
        ? matches ? `${matches} topic${matches === 1 ? '' : 's'} in ${visibleSubjects} subject${visibleSubjects === 1 ? '' : 's'}`
          : 'No topics match your search.'
        : `${topics.length} topics across ${sections.length} subjects`;
    }
  });
</script>

<style>
  /* Page-specific styles live in ../styles/learn.css (imported in frontmatter). */
</style>
