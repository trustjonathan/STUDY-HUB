---
import sharedStyles from '../styles/astro-site.css?url';
import legacyStyles from '../styles/legacy-refresh.css?url';
import SubjectFooterCarousel from '../components/SubjectFooterCarousel.astro';
import subjectCatalog from '../data/subjects.json';
import resourceManifest from '../data/resources.json';

interface Props {
  title: string;
  description?: string;
  dataPage?: string;
  bodyClass?: string;
}

const { title, description, dataPage, bodyClass } = Astro.props;
const currentSubject = subjectCatalog.find((subject) => subject.slug === dataPage);
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || resourceManifest.projectUrl;
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const home = base.replace(/\/$/, '');
const basePath = base.replace(/^\/|\/$/g, '');
const requestedPath = Astro.url.pathname.replace(/^\/+/, '');
const routePath = requestedPath === basePath
  ? ''
  : requestedPath.startsWith(`${basePath}/`)
    ? requestedPath.slice(basePath.length + 1)
    : requestedPath;
const canonicalPath = routePath === 'index.html' ? '' : routePath.replace(/\.html\.html$/, '.html');
const siteUrl = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(`${base}${canonicalPath}`, siteUrl);
const socialImageUrl = new URL(`${base}social-preview.png`, siteUrl);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {description && <meta name="description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={socialImageUrl.href} />
    <meta name="study-hub-reader-url" content={`${base}full_page_flipbook_viewer/index.html`} />
    <meta name="study-hub-supabase-url" content={supabaseUrl} />
    <meta name="study-hub-supabase-anon-key" content={supabaseAnonKey} />
    <title>{title}</title>
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" />
    <link rel="canonical" href={canonicalUrl.href} />
    <meta property="og:site_name" content="Study Hub" />
    <meta property="og:locale" content="en_UG" />
    <meta property="og:image:secure_url" content={socialImageUrl.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Study Hub connects Biology, Chemistry, Mathematics, and Physics notes with exam practice." />
    <meta name="twitter:image:alt" content="Study Hub connects Biology, Chemistry, Mathematics, and Physics notes with exam practice." />
    <link rel="icon" type="image/png" sizes="96x96" href={`${base}favicon-96x96.png`} />
    <link rel="icon" type="image/svg+xml" sizes="any" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <link rel="stylesheet" href={sharedStyles} />
    <link rel="stylesheet" href={legacyStyles} />
  </head>
  <body data-page={dataPage} class={bodyClass}>
    {currentSubject && <a class="skip-link" href="#main-content">Skip to main content</a>}
    <header class="site-header" id="top">
      <div class="utility-bar">
        <div class="utility-inner">
          <span class="utility-note">Made for Ugandan learners</span>
        </div>
      </div>
      <div class="header-main">
        <a class="brand" href={home} aria-label="Study Hub home">
          <img src={`${base}favicon.svg`} width="40" height="40" alt="" />
          <span>Study Hub</span>
        </a>
        <nav class="site-nav" aria-label="Main navigation">
          <a href={home}>Home</a>
          <a href={`${home}/subjects.html`}>Subjects</a>
          <a href={`${home}/frontend/src/html/about.html`}>About</a>
          <a href={`${home}/library-guide.html`}>Library guide</a>
        </nav>
      </div>
    </header>
    <slot />
    {currentSubject && <SubjectFooterCarousel subject={currentSubject.slug} />}
    <footer class="legacy-site-footer">
      <div class="legacy-footer-inner">
        <div class="legacy-footer-brand">
          <a class="brand" href={home} aria-label="Study Hub home">
            <img src={`${base}favicon.svg`} width="36" height="36" alt="" />
            <span>Study Hub</span>
          </a>
          <p>Free study resources for focused, confident revision.</p>
          <span class="legacy-footer-note">Made for Ugandan learners</span>
        </div>
        <nav class="legacy-footer-links" aria-label="Footer navigation">
          <h2>Explore</h2>
          <a href={`${home}/subjects.html`}>Browse subjects</a>
          <a href={`${home}/library-guide.html`}>Library guide</a>
          <a href={`${home}/privacy.html`}>Privacy</a>
          <a href={`${home}/terms.html`}>Terms</a>
        </nav>
        <div class="legacy-footer-contact">
          <h2>Get in touch</h2>
          <p>Have a question or a resource request?</p>
          <a href="mailto:trusteth777@gmail.com">Email Study Hub</a>
          <a href="https://wa.me/+256701810497">WhatsApp</a>
        </div>
        <div class="legacy-footer-bottom">
          <span>© {new Date().getFullYear()} Study Hub</span>
          <a href="#top">Back to top <span aria-hidden="true">↑</span></a>
        </div>
      </div>
    </footer>
  </body>
</html>