---
import logo from '../assets/images/logo.png';
import sharedStyles from '../styles/astro-site.css?url';
import legacyStyles from '../styles/legacy-refresh.css?url';

interface Props {
  title: string;
  description?: string;
  dataPage?: string;
  bodyClass?: string;
}

const { title, description, dataPage, bodyClass } = Astro.props;
const base = `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
    <slot name="head" />
    <link rel="stylesheet" href={sharedStyles} />
    <link rel="stylesheet" href={legacyStyles} />
  </head>
  <body data-page={dataPage} class={bodyClass}>
    <header class="site-header">
      <a class="brand" href={base} aria-label="Study Hub home">
        <img src={logo.src} width="40" height="40" alt="" />
        <span>Study Hub</span>
      </a>
      <nav aria-label="Main navigation">
        <a href={`${base}#subjects`}>Subjects</a>
        <a href={`${base}#practice`}>Exam practice</a>
        <a href={`${base}frontend/src/html/about.html`}>About</a>
      </nav>
    </header>
    <slot />
  </body>
</html>