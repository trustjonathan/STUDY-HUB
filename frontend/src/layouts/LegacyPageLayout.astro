---
import logo from '../assets/images/logo.png';
import sharedStyles from '../styles/astro-site.css?url';
import legacyStyles from '../styles/legacy-refresh.css?url';

interface Props {
  title: string;
  description?: string;
  dataPage?: string;
  bodyClass?: string;
}

const { title, description, dataPage, bodyClass } = Astro.props;
const base = `${import.meta.env.BASE_URL}/`;
const home = base.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
    <slot name="head" />
    <link rel="stylesheet" href={sharedStyles} />
    <link rel="stylesheet" href={legacyStyles} />
  </head>
  <body data-page={dataPage} class={bodyClass}>
    <header class="site-header" id="top">
      <div class="utility-bar">
        <div class="utility-inner">
          <nav class="utility-links" aria-label="Utility navigation">
            <a href={`${home}/frontend/src/html/about.html`}>About</a>
            <a href="mailto:trusteth777@gmail.com">Contact</a>
          </nav>
          <span class="utility-note">Made for Ugandan learners</span>
        </div>
      </div>
      <div class="header-main">
        <nav class="site-nav" aria-label="Main navigation">
          <a href={home}>Home</a>
          <a href={`${home}#normal-pages`}>Subjects</a>
          <a href="https://trustjonathan.github.io/BIOLOGY/archive.html">Archives</a>
        </nav>
        <a class="brand" href={home} aria-label="Study Hub home">
          <img src={logo.src} width="40" height="40" alt="" />
          <span>Study Hub</span>
        </a>
        <nav class="header-actions" aria-label="Quick actions">
          <a href="mailto:trusteth777@gmail.com">Contact Study Hub</a>
          <a href="https://trustjonathan.github.io/STUDY-HUB/">Back to home</a>
        </nav>
      </div>
      <nav class="mega-nav" aria-label="Study Hub sections">
        <section class="mega-nav-group">
          <h2>Study Hub</h2>
          <a href={home}>Home</a>
          <a href={`${home}/frontend/src/html/about.html`}>About</a>
        </section>
        <section class="mega-nav-group">
          <h2>Biology</h2>
          <a href={`${home}/frontend/src/html/biology.html`}>Biology study hub</a>
          <a href="https://trustjonathan.github.io/BIOLOGY/archive.html">Biology archive</a>
        </section>
        <section class="mega-nav-group">
          <h2>Chemistry</h2>
          <a href={`${home}/frontend/src/html/chemistry.html`}>Chemistry study hub</a>
          <a href="https://trustjonathan.github.io/CHEMISTRY/archive.html">Chemistry archive</a>
        </section>
        <section class="mega-nav-group">
          <h2>Mathematics</h2>
          <a href={`${home}/frontend/src/html/mathematics.html`}>Mathematics study hub</a>
          <a href="https://trustjonathan.github.io/MATHEMATICS/archive.html">Mathematics archive</a>
        </section>
        <section class="mega-nav-group">
          <h2>Contact</h2>
          <a href="mailto:trusteth777@gmail.com">Email Study Hub</a>
          <a href="https://wa.me/+256701810497">WhatsApp</a>
        </section>
      </nav>
    </header>
    <slot />
    <footer class="legacy-site-footer">
      <div class="legacy-footer-inner">
        <div class="legacy-footer-brand">
          <a class="brand" href={home} aria-label="Study Hub home">
            <img src={logo.src} width="36" height="36" alt="" />
            <span>Study Hub</span>
          </a>
          <p>Free study resources for focused, confident revision.</p>
          <span class="legacy-footer-note">Made for Ugandan learners</span>
        </div>
        <nav class="legacy-footer-links" aria-label="Footer navigation">
          <h2>Explore</h2>
          <a href={home}>Home</a>
          <a href="https://trustjonathan.github.io/BIOLOGY/">Biology</a>
          <a href="https://trustjonathan.github.io/CHEMISTRY/">Chemistry</a>
          <a href="https://trustjonathan.github.io/MATHEMATICS/archive.html">Mathematics</a>
          <a href="https://trustjonathan.github.io/BIOLOGY/archive.html">Biology archive</a>
          <a href="https://trustjonathan.github.io/CHEMISTRY/archive.html">Chemistry archive</a>
          <a href="https://trustjonathan.github.io/MATHEMATICS/archive.html">Mathematics archive</a>
        </nav>
        <div class="legacy-footer-contact">
          <h2>Get in touch</h2>
          <p>Have a question or a resource request?</p>
          <a href="mailto:trusteth777@gmail.com">Email Study Hub</a>
          <a href="https://wa.me/+256701810497">WhatsApp</a>
        </div>
        <div class="legacy-footer-bottom">
          <span>© {new Date().getFullYear()} Study Hub</span>
          <a href="#top">Back to top <span aria-hidden="true">↑</span></a>
        </div>
      </div>
    </footer>
  </body>
</html>