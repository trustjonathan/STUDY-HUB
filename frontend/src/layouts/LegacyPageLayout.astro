---
import sharedStyles from '../styles/astro-site.css?url';
import legacyStyles from '../styles/legacy-refresh.css?url';
import ResumeProgress from '../components/ResumeProgress.astro';
import SubjectFooterCarousel from '../components/SubjectFooterCarousel.astro';
import { availableSubjects } from '../data/availableSubjects';
import subjectCatalog from '../data/subjects.json';
import resourceManifest from '../data/resources.json';

interface Props {
  title: string;
  description?: string;
  dataPage?: string;
  bodyClass?: string;
}

const { title, description, dataPage, bodyClass } = Astro.props;
const currentSubject = subjectCatalog.find((subject) => subject.slug === dataPage);
const popularSubjects = availableSubjects;
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || resourceManifest.projectUrl;
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const home = base.replace(/\/$/, '');
const basePath = base.replace(/^\/|\/$/g, '');
const requestedPath = Astro.url.pathname.replace(/^\/+/, '');
const routePath = requestedPath === basePath
  ? ''
  : requestedPath.startsWith(`${basePath}/`)
    ? requestedPath.slice(basePath.length + 1)
    : requestedPath;
const canonicalPath = routePath === 'index.html' ? '' : routePath.replace(/\.html\.html$/, '.html');
const siteUrl = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(`${base}${canonicalPath}`, siteUrl);
const socialImageUrl = new URL(`${base}social-preview.png`, siteUrl);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {description && <meta name="description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={socialImageUrl.href} />
    <meta name="study-hub-reader-url" content={`${base}full_page_flipbook_viewer/index.html`} />
    <meta name="study-hub-supabase-url" content={supabaseUrl} />
    <meta name="study-hub-supabase-anon-key" content={supabaseAnonKey} />
    <title>{title}</title>
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="icon" type="image/x-icon" href={`${base}favicon.ico`} />
    <meta property="og:site_name" content="Study Hub" />
    <meta property="og:locale" content="en_UG" />
    <meta property="og:image:secure_url" content={socialImageUrl.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Study Hub connects Biology, Chemistry, Mathematics, and Physics notes with exam practice." />
    <meta name="twitter:image:alt" content="Study Hub connects Biology, Chemistry, Mathematics, and Physics notes with exam practice." />
    <link rel="icon" type="image/png" sizes="96x96" href={`${base}favicon-96x96.png`} />
    <link rel="icon" type="image/svg+xml" sizes="any" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <link rel="stylesheet" href={sharedStyles} />
    <link rel="stylesheet" href={legacyStyles} />
  </head>
  <body data-page={dataPage} class={bodyClass}>
    {currentSubject && <a class="skip-link" href="#main-content">Skip to main content</a>}
    <header class="site-header clean-site-header" id="top">
      <div class="header-main">
        <a class="brand" href={home} aria-label="Study Hub home">
          <img src={`${base}favicon.svg`} width="40" height="40" alt="" />
          <span>Study Hub</span>
        </a>
        <nav class="site-nav" aria-label="Main navigation">
          <a href={home}>Home</a>
          <a href={`${home}/subjects.html`}>Subjects</a>
          <a href={`${home}/blog.html`}>Blog</a>
          <a href={`${home}/library.html`}>Library</a>
          <a href={`${home}/assistant.html`}>AI Study</a>
          <a href={`${home}/frontend/src/html/about.html`}>About</a>
          <a href={`${home}/admin/payments.html`} data-admin-payments-link hidden>Payment verification</a>
        </nav>
        <a class="header-sign-in" href={`${home}/sign-in.html`}>
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M15 21h4a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2h-4M10 17l5-5-5-5m5 5H3" /></svg>
          <span>Sign in</span>
        </a>
      </div>
    </header>
    <script>
      import { readAuthSession } from '../utils/authSession';

      interface HeaderUser {
        role?: string;
      }

      const adminPaymentsLink = document.querySelector<HTMLAnchorElement>('[data-admin-payments-link]');

      function updateAdminPaymentsLink() {
        try {
          const session = readAuthSession<HeaderUser>();
          if (adminPaymentsLink) adminPaymentsLink.hidden = session?.user.role !== 'admin';
        } catch {
          if (adminPaymentsLink) adminPaymentsLink.hidden = true;
        }
      }

      updateAdminPaymentsLink();
      window.addEventListener('study-hub-auth-change', updateAdminPaymentsLink);
    </script>
    <slot />
    {currentSubject && <SubjectFooterCarousel subject={currentSubject.slug} />}
    <footer class="legacy-site-footer">
      <div class="legacy-footer-inner legacy-subject-footer">
        <div class="legacy-footer-brand">
          <a class="legacy-footer-mark" href={home} aria-label="Study Hub home">
            <img src={`${base}favicon.svg`} width="46" height="46" alt="" />
          </a>
          <nav class="legacy-footer-socials" aria-label="Contact Study Hub">
            <a href="https://wa.me/256701810497" aria-label="Contact Study Hub on WhatsApp" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 11.8a8.5 8.5 0 0 1-12.6 7.4L3 20.5l1.4-4.7a8.5 8.5 0 1 1 16.1-4ZM9 8.2c.2-.4.4-.4.7-.4h.5c.2 0 .4.1.5.4l.8 1.9c.1.2.1.4-.1.6l-.6.7c-.2.2-.2.4-.1.6.5.9 1.2 1.5 2.1 1.9.2.1.4 0 .6-.2l.8-.9c.2-.2.4-.2.6-.1l1.8.9c.2.1.3.3.3.5 0 .3-.2 1.1-.7 1.5-.5.5-1.2.7-2 .6-1.1-.1-2.4-.7-3.7-1.8-1.1-1-1.9-2.2-2.2-3.2-.3-1 .1-2 .7-3Z" /></svg>
            </a>
            <a href="mailto:trusteth777@gmail.com" aria-label="Email Study Hub">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></svg>
            </a>
          </nav>
        </div>
        <nav class="legacy-footer-column" aria-label="Products">
          <h2>Product</h2>
          <a href={`${home}/subjects.html`}>Browse subjects</a>
          <a href={`${home}/library.html`}>Study library</a>
          <a href={`${home}/assistant.html`}>AI Study</a>
          <a href={`${home}/learn.html`}>AI Study Guides</a>
          <a href={`${home}/sign-in.html`}>Sign in</a>
          <a href={`${home}/under-development.html`}>Pages in development</a>
        </nav>
        <nav class="legacy-footer-column" aria-label="Learning solutions">
          <h2>Solutions</h2>
          <a href={`${home}/library.html#library-classes`}>Primary learners</a>
          <a href={`${home}/library.html#library-classes`}>O-Level learners</a>
          <a href={`${home}/library.html#library-classes`}>A-Level learners</a>
          {popularSubjects.map((subject) => (
            <a href={`${home}/frontend/src/html/${subject.slug}.html`}>For {subject.name}</a>
          ))}
          <a href={`${home}/under-development.html`}>University · in development</a>
        </nav>
        <nav class="legacy-footer-column" aria-label="Study Hub resources">
          <h2>Resources</h2>
          <a href={`${home}/library-guide.html`}>Library guide</a>
          <a href={`${home}/blog.html`}>Study Hub Blog</a>
          <a href={`${home}/community-chat.html`}>Suggestions</a>
          <a href={`${home}/subjects.html`}>Subject directory</a>
          <a href={`${home}/ads-and-partnerships.html`}>Ads &amp; partnerships</a>
        </nav>
        <nav class="legacy-footer-column legacy-footer-company" aria-label="Company and legal policies">
          <h2>Company</h2>
          <a href={`${home}/frontend/src/html/about.html`}>About Study Hub</a>
          <a href="mailto:trusteth777@gmail.com">Contact</a>
          <a href={`${home}/documentation.html`}>Documentation</a>
          <a href={`${home}/legal.html`}>Legal</a>
        </nav>
        <div class="legacy-footer-bottom">
          <span>© {new Date().getFullYear()} Study Hub</span>
          <a href="#top">Back to top <span aria-hidden="true">↑</span></a>
        </div>
      </div>
    </footer>
    <ResumeProgress />
  </body>
</html>