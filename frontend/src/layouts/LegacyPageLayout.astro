---
interface Props {
  title: string;
  description?: string;
  dataPage?: string;
  bodyClass?: string;
}

const { title, description, dataPage, bodyClass } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body data-page={dataPage} class={bodyClass}>
    <slot />
  </body>
</html>