---
import logo from '../assets/images/logo.png';
import sharedStyles from '../styles/astro-site.css?url';
import legacyStyles from '../styles/legacy-refresh.css?url';

interface Props {
  title: string;
  description?: string;
  dataPage?: string;
  bodyClass?: string;
}

const { title, description, dataPage, bodyClass } = Astro.props;
const base = `${import.meta.env.BASE_URL}/`;
const home = base.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
    <slot name="head" />
    <link rel="stylesheet" href={sharedStyles} />
    <link rel="stylesheet" href={legacyStyles} />
  </head>
  <body data-page={dataPage} class={bodyClass}>
    <header class="site-header" id="top">
      <a class="brand" href={home} aria-label="Study Hub home">
        <img src={logo.src} width="40" height="40" alt="" />
        <span>Study Hub</span>
      </a>
      <nav aria-label="Main navigation">
        <a href={`${base}frontend/src/html/biology.html`} aria-current={dataPage === 'biology' ? 'page' : undefined}>Biology</a>
        <a href={`${base}frontend/src/html/chemistry.html`} aria-current={dataPage === 'chemistry' ? 'page' : undefined}>Chemistry</a>
        <a href={`${base}frontend/src/html/mathematics.html`} aria-current={dataPage === 'mathematics' ? 'page' : undefined}>Mathematics</a>
        <details class="archive-nav">
          <summary>Archives</summary>
          <div class="archive-nav-menu">
            <a href="https://trustjonathan.github.io/BIOLOGY/">Biology archive</a>
            <a href={`${base}frontend/src/html/chemistry.html#chemistry-library`}>Chemistry archive</a>
            <a href="https://trustjonathan.github.io/MATHEMATICS/archive.html">Mathematics archive</a>
          </div>
        </details>
        <a href={`${base}frontend/src/html/about.html`} aria-current={dataPage === 'about' ? 'page' : undefined}>About</a>
      </nav>
    </header>
    <slot />
    <footer class="legacy-site-footer">
      <div class="legacy-footer-inner">
        <div class="legacy-footer-brand">
          <a class="brand" href={home} aria-label="Study Hub home">
            <img src={logo.src} width="36" height="36" alt="" />
            <span>Study Hub</span>
          </a>
          <p>Free study resources for focused, confident revision.</p>
          <span class="legacy-footer-note">Made for Ugandan learners</span>
        </div>
        <nav class="legacy-footer-links" aria-label="Footer navigation">
          <h2>Explore</h2>
          <a href={`${base}frontend/src/html/biology.html`}>Biology</a>
          <a href="https://trustjonathan.github.io/BIOLOGY/">Biology archive</a>
          <a href={`${base}frontend/src/html/chemistry.html`}>Chemistry</a>
          <a href={`${base}frontend/src/html/mathematics.html`}>Mathematics</a>
          <a href={`${base}frontend/src/html/about.html`}>About Study Hub</a>
        </nav>
        <div class="legacy-footer-contact">
          <h2>Get in touch</h2>
          <p>Have a question or a resource request?</p>
          <a href="mailto:trusteth777@gmail.com">Email Study Hub</a>
          <a href="https://wa.me/+256701810497">WhatsApp</a>
        </div>
        <div class="legacy-footer-bottom">
          <span>© {new Date().getFullYear()} Study Hub</span>
          <a href="#top">Back to top <span aria-hidden="true">↑</span></a>
        </div>
      </div>
    </footer>
  </body>
</html>