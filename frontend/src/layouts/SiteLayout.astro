---
import '../styles/astro-site.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Study Hub | Learn with clarity',
  description = 'Study notes, exam resources, and learning tools for Biology, Chemistry, and Mathematics.'
} = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const home = base.replace(/\/$/, '');
const basePath = base.replace(/^\/|\/$/g, '');
const requestedPath = Astro.url.pathname.replace(/^\/+/, '');
const routePath = requestedPath === basePath
  ? ''
  : requestedPath.startsWith(`${basePath}/`)
    ? requestedPath.slice(basePath.length + 1)
    : requestedPath;
const canonicalPath = routePath === 'index.html' ? '' : routePath.replace(/\.html\.html$/, '.html');
const siteUrl = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(`${base}${canonicalPath}`, siteUrl);
const socialImageUrl = new URL(`${base}social-preview.png`, siteUrl);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#102a40" />
    <link rel="canonical" href={canonicalUrl.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Study Hub" />
    <meta property="og:locale" content="en_UG" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={socialImageUrl.href} />
    <meta property="og:image:secure_url" content={socialImageUrl.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Study Hub connects Biology, Chemistry, and Mathematics notes with exam practice." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl.href} />
    <meta name="twitter:image:alt" content="Study Hub connects Biology, Chemistry, and Mathematics notes with exam practice." />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header" id="top">
      <div class="utility-bar">
        <div class="utility-inner">
          <nav class="utility-links" aria-label="Utility navigation">
            <a href={`${home}/frontend/src/html/about.html`}>About</a>
          </nav>
          <span class="utility-note">Made for Ugandan learners</span>
        </div>
      </div>
      <div class="header-main">
        <nav class="site-nav" aria-label="Main navigation">
          <a href={home}>Home</a>
          <a href={`${home}#overview`}>Overview</a>
          <a href={`${home}#subjects`}>Subjects</a>
        </nav>
        <a class="brand" href={home} aria-label="Study Hub home">
          <img src={`${base}favicon.svg`} width="40" height="40" alt="" />
          <span>Study Hub</span>
        </a>
        <nav class="header-actions" aria-label="Quick actions">
          <a href={`${home}#subjects`}>Explore subjects</a>
        </nav>
      </div>
      <nav class="mega-nav" aria-label="Study Hub sections">
        <details class="mega-nav-group">
          <summary>Study Hub</summary>
          <div class="mega-nav-panel">
            <a href={home}>Home</a>
            <a href={`${home}/frontend/src/html/about.html`}>About</a>
          </div>
        </details>
        <details class="mega-nav-group">
          <summary>Biology</summary>
          <div class="mega-nav-panel">
            <a href={`${home}/frontend/src/html/biology.html`}>Biology study hub</a>
            <a href="https://trustjonathan.github.io/BIOLOGY/archive.html">Biology archive</a>
          </div>
        </details>
        <details class="mega-nav-group">
          <summary>Chemistry</summary>
          <div class="mega-nav-panel">
            <a href={`${home}/frontend/src/html/chemistry.html`}>Chemistry study hub</a>
            <a href="https://trustjonathan.github.io/CHEMISTRY/archive.html">Chemistry archive</a>
          </div>
        </details>
        <details class="mega-nav-group">
          <summary>Mathematics</summary>
          <div class="mega-nav-panel">
            <a href={`${home}/frontend/src/html/mathematics.html`}>Mathematics study hub</a>
            <a href="https://trustjonathan.github.io/MATHEMATICS/archive.html">Mathematics archive</a>
          </div>
        </details>
        <details class="mega-nav-group">
          <summary>Resources</summary>
          <div class="mega-nav-panel">
            <a href={`${home}#subjects`}>Browse subjects</a>
            <a href={`${home}/library-guide.html`}>Library guide</a>
          </div>
        </details>
      </nav>
    </header>
    <slot />
    <footer class="site-footer legacy-site-footer" id="footer-links">
      <div class="legacy-footer-inner">
        <div class="legacy-footer-brand">
          <a class="brand" href={home} aria-label="Study Hub home">
            <img src={`${base}favicon.svg`} width="36" height="36" alt="" />
            <span>Study Hub</span>
          </a>
          <p>Free study resources for focused, confident revision.</p>
          <span class="legacy-footer-note">Made for Ugandan learners</span>
        </div>
        <nav class="legacy-footer-links" aria-label="Footer navigation">
          <h2>Explore</h2>
          <a href={home}>Home</a>
          <a href={`${home}/library-guide.html`}>Library guide</a>
          <a href={`${home}/frontend/src/html/biology.html`}>Biology</a>
          <a href={`${home}/frontend/src/html/chemistry.html`}>Chemistry</a>
          <a href={`${home}/frontend/src/html/mathematics.html`}>Mathematics</a>
          <a href="https://trustjonathan.github.io/BIOLOGY/archive.html">Biology archive</a>
          <a href="https://trustjonathan.github.io/CHEMISTRY/archive.html">Chemistry archive</a>
          <a href="https://trustjonathan.github.io/MATHEMATICS/archive.html">Mathematics archive</a>
        </nav>
        <div class="legacy-footer-contact">
          <h2>Get in touch</h2>
          <p>Have a question or a resource request?</p>
          <a href="mailto:trusteth777@gmail.com">Email Study Hub</a>
          <a href="https://wa.me/+256701810497">WhatsApp</a>
        </div>
        <div class="legacy-footer-bottom">
          <span>© {new Date().getFullYear()} Study Hub</span>
          <a href="#top">Back to top <span aria-hidden="true">↑</span></a>
        </div>
      </div>
    </footer>
    <script>
      const desktopHover = window.matchMedia('(hover: hover) and (min-width: 761px)');
      document.querySelectorAll<HTMLDetailsElement>('.mega-nav-group').forEach((group) => {
        group.addEventListener('pointerenter', () => {
          if (desktopHover.matches) group.open = true;
        });
        group.addEventListener('pointerleave', () => {
          if (desktopHover.matches && !group.contains(document.activeElement)) group.open = false;
        });
        group.addEventListener('focusin', () => {
          if (desktopHover.matches) group.open = true;
        });
        group.addEventListener('focusout', (event) => {
          const nextTarget = event.relatedTarget;
          if (desktopHover.matches && !(nextTarget instanceof Node && group.contains(nextTarget)) && !group.matches(':hover')) {
            group.open = false;
          }
        });
      });
    </script>
  </body>
</html>