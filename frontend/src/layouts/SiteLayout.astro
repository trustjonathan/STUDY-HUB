---
import logo from '../assets/images/logo.png';
import '../styles/astro-site.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Study Hub | Learn with clarity',
  description = 'Study notes, exam resources, and learning tools for Biology, Chemistry, and Mathematics.'
} = Astro.props;
const base = `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f5ef" />
    <link rel="icon" type="image/png" href={logo.src} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={base} aria-label="Study Hub home">
        <img src={logo.src} width="40" height="40" alt="" />
        <span>Study Hub</span>
      </a>
      <nav aria-label="Main navigation">
        <a href={`${base}#subjects`}>Subjects</a>
        <a href={`${base}#practice`}>Exam practice</a>
        <a href={`${base}frontend/src/html/about.html`}>About</a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <a class="brand" href={base}>
        <img src={logo.src} width="32" height="32" alt="" />
        <span>Study Hub</span>
      </a>
      <p>Free study resources for focused, confident revision.</p>
      <span>Made for Ugandan learners</span>
    </footer>
  </body>
</html>