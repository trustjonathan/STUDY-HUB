---
import '../styles/astro-site.css';
import '../styles/design-tokens.css';
import ResumeProgress from '../components/ResumeProgress.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title?: string;
  description?: string;
  manifestHref?: string;
}

const {
  title = 'Study Hub | Learn with clarity',
  description = 'Study notes, exam resources, and learning tools across a growing range of school subjects.',
  manifestHref
} = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const home = base.replace(/\/$/, '');
const basePath = base.replace(/^\/|\/$/g, '');
const requestedPath = Astro.url.pathname.replace(/^\/+/, '');
const routePath = requestedPath === basePath
  ? ''
  : requestedPath.startsWith(`${basePath}/`)
    ? requestedPath.slice(basePath.length + 1)
    : requestedPath;
const routeKey = routePath.replace(/\.html(?:\.html)?$/, '').replace(/\/+$/, '');
const showFooter = !['assistant', 'library', 'sign-in', 'document-payment', 'study'].includes(routeKey);
const isPolicyPage = ['legal', 'privacy', 'terms', 'copyright'].includes(routeKey);
const canonicalPath = routePath === 'index.html' ? '' : routePath.replace(/\.html\.html$/, '.html');
const siteUrl = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(`${base}${canonicalPath}`, siteUrl);
const socialImageUrl = new URL(`${base}social-preview.png`, siteUrl);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#102a40" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="icon" type="image/x-icon" href={`${base}favicon.ico`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Study Hub" />
    <meta property="og:locale" content="en_UG" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={socialImageUrl.href} />
    <meta property="og:image:secure_url" content={socialImageUrl.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Study Hub connects subject learning resources with exam practice." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl.href} />
    <meta name="twitter:image:alt" content="Study Hub connects subject learning resources with exam practice." />
    <link rel="icon" type="image/png" sizes="96x96" href={`${base}favicon-96x96.png`} />
    <link rel="icon" type="image/svg+xml" sizes="any" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={manifestHref ?? `${base}site.webmanifest`} />
    {routeKey === 'sign-in' && (
      <script is:inline src="https://accounts.google.com/gsi/client" async defer></script>
    )}
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body data-page={routeKey} class:list={{ 'policy-page': isPolicyPage }}>
    <SiteHeader base={base} home={home} routeKey={routeKey} />
    {isPolicyPage ? (
      <div class="legal-document-layout">
        <aside class="legal-document-sidebar" aria-label="Legal documents">
          <p>Legal</p>
          <nav>
            <a href={`${home}/terms.html`} aria-current={routeKey === 'terms' ? 'page' : undefined}>Terms of use</a>
            <a href={`${home}/privacy.html`} aria-current={routeKey === 'privacy' ? 'page' : undefined}>Privacy policy</a>
            <a href={`${home}/copyright.html`} aria-current={routeKey === 'copyright' ? 'page' : undefined}>Copyright information</a>
            <a href={`${home}/legal.html`} aria-current={routeKey === 'legal' ? 'page' : undefined}>Legal overview</a>
          </nav>
        </aside>
        <div class="legal-document-content"><slot /></div>
      </div>
    ) : <slot />}
    {showFooter && (
      <SiteFooter home={home} />
    )}
    <ResumeProgress />
  </body>
</html>