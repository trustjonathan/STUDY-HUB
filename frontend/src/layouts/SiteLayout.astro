---
import '../styles/astro-site.css';
import { availableSubjects } from '../data/availableSubjects';
import ResumeProgress from '../components/ResumeProgress.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Study Hub | Learn with clarity',
  description = 'Study notes, exam resources, and learning tools for Biology, Chemistry, Mathematics, and Physics.'
} = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const home = base.replace(/\/$/, '');
const basePath = base.replace(/^\/|\/$/g, '');
const requestedPath = Astro.url.pathname.replace(/^\/+/, '');
const routePath = requestedPath === basePath
  ? ''
  : requestedPath.startsWith(`${basePath}/`)
    ? requestedPath.slice(basePath.length + 1)
    : requestedPath;
const routeKey = routePath.replace(/\.html(?:\.html)?$/, '').replace(/\/+$/, '');
const showFooter = !['assistant', 'library', 'sign-in', 'document-payment'].includes(routeKey);
const isPolicyPage = ['legal', 'privacy', 'terms', 'copyright'].includes(routeKey);
const canonicalPath = routePath === 'index.html' ? '' : routePath.replace(/\.html\.html$/, '.html');
const siteUrl = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(`${base}${canonicalPath}`, siteUrl);
const socialImageUrl = new URL(`${base}social-preview.png`, siteUrl);
const popularSubjects = availableSubjects;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#102a40" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="icon" type="image/x-icon" href={`${base}favicon.ico`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Study Hub" />
    <meta property="og:locale" content="en_UG" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={socialImageUrl.href} />
    <meta property="og:image:secure_url" content={socialImageUrl.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Study Hub connects Biology, Chemistry, Mathematics, and Physics notes with exam practice." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl.href} />
    <meta name="twitter:image:alt" content="Study Hub connects Biology, Chemistry, Mathematics, and Physics notes with exam practice." />
    <link rel="icon" type="image/png" sizes="96x96" href={`${base}favicon-96x96.png`} />
    <link rel="icon" type="image/svg+xml" sizes="any" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    {routeKey === 'sign-in' && (
      <script is:inline src="https://accounts.google.com/gsi/client" async defer></script>
    )}
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body data-page={routeKey} class:list={{ 'policy-page': isPolicyPage }}>
    <header class="site-header clean-site-header" id="top">
      <div class="header-main">
        <div class="brand-group">
          <a class="brand" href={home} aria-label="Study Hub home">
            <img src={`${base}favicon.svg`} width="40" height="40" alt="" />
            <span>Study Hub</span>
          </a>
          <span class="service-anniversary" aria-label="Two years serving Uganda">
            <svg class="uganda-flag" role="img" aria-label="Ugandan flag" viewBox="0 0 30 20">
              <rect width="30" height="20" fill="#000" />
              <path fill="#fcdc04" d="M0 3.33h30v3.34H0zM0 10h30v3.33H0z" />
              <path fill="#d90000" d="M0 6.67h30V10H0zM0 13.33h30V20H0z" />
              <circle cx="15" cy="10" r="4.15" fill="#fff" />
              <path d="M14.7 6.9h.65l.45 1.3 1.15-.42.3.45-.82.85.7.76-.4.35-.83-.4-.2 2.05-.45 1.1-.45-1.1.05-2.25-.88.57-.35-.38.78-.86-.78-.58.28-.48 1.05.36.55-1.32Zm-.6 5.72-.85.95h.75l.6-.55.6.55h.8l-.9-.95Z" fill="#777" />
            </svg>
            <span class="service-anniversary-copy"><strong>2 years</strong><span>of serving Ugandans</span></span>
          </span>
        </div>
        <nav class="site-nav" aria-label="Main navigation">
          <a href={home}>Home</a>
          <a href={`${home}/subjects.html`}>Subjects</a>
          <a href={`${home}/blog.html`} aria-current={routeKey === 'blog' ? 'page' : undefined}>Blog</a>
          <a href={`${home}/library.html`}>Library</a>
          <a href={`${home}/assistant.html`}>AI Study</a>
          <a href={`${home}/frontend/src/html/about.html`}>About</a>
          <a href={`${home}/admin/payments.html`} data-admin-payments-link hidden>Payment verification</a>
        </nav>
        <a class="header-sign-in" data-header-sign-in href={`${home}/sign-in.html`}>
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M15 21h4a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2h-4M10 17l5-5-5-5m5 5H3" /></svg>
          <span>Sign in</span>
        </a>
        <div class="header-account" data-header-account hidden>
          <details class="header-account-menu">
            <summary aria-label="Open account menu">
              <span class="header-account-avatar" data-account-avatar aria-hidden="true">A</span>
            </summary>
            <div class="header-account-dropdown">
              <strong data-account-name>Account</strong>
              <span data-account-email></span>
              <a href={`${home}/account.html`}>Profile &amp; settings</a>
              <button type="button" data-account-sign-out>Sign out</button>
            </div>
          </details>
        </div>
      </div>
    </header>
    <script>
      import { clearAuthSession, readAuthSession } from '../utils/authSession';

      interface HeaderAccount {
        username?: string;
        email?: string;
        role?: string;
      }

      const signInLink = document.querySelector<HTMLElement>('[data-header-sign-in]');
      const accountMenu = document.querySelector<HTMLElement>('[data-header-account]');
      const adminPaymentsLink = document.querySelector<HTMLAnchorElement>('[data-admin-payments-link]');
      const accountAvatar = document.querySelector<HTMLElement>('[data-account-avatar]');
      const accountName = document.querySelector<HTMLElement>('[data-account-name]');
      const accountEmail = document.querySelector<HTMLElement>('[data-account-email]');
      const signOutButton = document.querySelector<HTMLButtonElement>('[data-account-sign-out]');

      function updateHeaderAccount() {
        try {
          const session = readAuthSession<HeaderAccount>();
          const user = session?.user;
          if (!user || typeof user.email !== 'string') {
            if (signInLink) signInLink.hidden = false;
            if (accountMenu) accountMenu.hidden = true;
            if (adminPaymentsLink) adminPaymentsLink.hidden = true;
            return;
          }

          const displayName = user.username?.trim() || user.email;
          const initials = displayName.split(/\s+/).slice(0, 2).map((part) => part[0]).join('');
          if (accountAvatar) accountAvatar.textContent = initials.toUpperCase();
          if (accountName) accountName.textContent = displayName;
          if (accountEmail) accountEmail.textContent = user.email;
          if (signInLink) signInLink.hidden = true;
          if (accountMenu) accountMenu.hidden = false;
          if (adminPaymentsLink) adminPaymentsLink.hidden = user.role !== 'admin';
        } catch {
          if (signInLink) signInLink.hidden = false;
          if (accountMenu) accountMenu.hidden = true;
          if (adminPaymentsLink) adminPaymentsLink.hidden = true;
        }
      }

      updateHeaderAccount();
      window.addEventListener('study-hub-auth-change', updateHeaderAccount);
      signOutButton?.addEventListener('click', () => {
        clearAuthSession();
        const details = signOutButton.closest('details');
        if (details) details.open = false;
      });
      document.addEventListener('click', (event) => {
        const target = event.target;
        if (target instanceof Node && !accountMenu?.contains(target)) {
          const details = accountMenu?.querySelector('details');
          if (details) details.open = false;
        }
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          const details = accountMenu?.querySelector('details');
          if (details) details.open = false;
        }
      });
    </script>
    {isPolicyPage ? (
      <div class="legal-document-layout">
        <aside class="legal-document-sidebar" aria-label="Legal documents">
          <p>Legal</p>
          <nav>
            <a href={`${home}/terms.html`} aria-current={routeKey === 'terms' ? 'page' : undefined}>Terms of use</a>
            <a href={`${home}/privacy.html`} aria-current={routeKey === 'privacy' ? 'page' : undefined}>Privacy policy</a>
            <a href={`${home}/copyright.html`} aria-current={routeKey === 'copyright' ? 'page' : undefined}>Copyright information</a>
            <a href={`${home}/legal.html`} aria-current={routeKey === 'legal' ? 'page' : undefined}>Legal overview</a>
          </nav>
        </aside>
        <div class="legal-document-content"><slot /></div>
      </div>
    ) : <slot />}
    {showFooter && (
      <footer class="site-footer legacy-site-footer" id="footer-links">
        <div class="legacy-footer-inner">
          <div class="legacy-footer-brand">
            <a class="legacy-footer-mark" href={home} aria-label="Study Hub home">
              <img src={`${base}favicon.svg`} width="46" height="46" alt="" />
            </a>
            <nav class="legacy-footer-socials" aria-label="Contact Study Hub">
              <a href="https://wa.me/256701810497" aria-label="Contact Study Hub on WhatsApp" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 11.8a8.5 8.5 0 0 1-12.6 7.4L3 20.5l1.4-4.7a8.5 8.5 0 1 1 16.1-4ZM9 8.2c.2-.4.4-.4.7-.4h.5c.2 0 .4.1.5.4l.8 1.9c.1.2.1.4-.1.6l-.6.7c-.2.2-.2.4-.1.6.5.9 1.2 1.5 2.1 1.9.2.1.4 0 .6-.2l.8-.9c.2-.2.4-.2.6-.1l1.8.9c.2.1.3.3.3.5 0 .3-.2 1.1-.7 1.5-.5.5-1.2.7-2 .6-1.1-.1-2.4-.7-3.7-1.8-1.1-1-1.9-2.2-2.2-3.2-.3-1 .1-2 .7-3Z" /></svg>
              </a>
              <a href="mailto:trusteth777@gmail.com" aria-label="Email Study Hub">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></svg>
              </a>
            </nav>
          </div>
          <nav class="legacy-footer-column" aria-label="Products">
            <h2>Product</h2>
            <a href={`${home}/subjects.html`}>Browse subjects</a>
            <a href={`${home}/library.html`}>Study library</a>
            <a href={`${home}/assistant.html`}>AI Study</a>
            <a href={`${home}/learn.html`}>AI Study Guides</a>
            <a href={`${home}/sign-in.html`}>Sign in</a>
            <a href={`${home}/under-development.html`}>Pages in development</a>
          </nav>
          <nav class="legacy-footer-column" aria-label="Learning solutions">
            <h2>Solutions</h2>
            <a href={`${home}/library.html#library-classes`}>Primary learners</a>
            <a href={`${home}/library.html#library-classes`}>O-Level learners</a>
            <a href={`${home}/library.html#library-classes`}>A-Level learners</a>
            {popularSubjects.map((subject) => (
              <a href={`${home}/frontend/src/html/${subject.slug}.html`}>For {subject.name}</a>
            ))}
            <a href={`${home}/under-development.html`}>University · in development</a>
          </nav>
          <nav class="legacy-footer-column" aria-label="Study Hub resources">
            <h2>Resources</h2>
            <a href={`${home}/library-guide.html`}>Library guide</a>
            <a href={`${home}/blog.html`}>Study Hub Blog</a>
            <a href={`${home}/community-chat.html`}>Suggestions</a>
            <a href={`${home}/subjects.html`}>Subject directory</a>
            <a href={`${home}/ads-and-partnerships.html`}>Ads &amp; partnerships</a>
          </nav>
          <nav class="legacy-footer-column legacy-footer-company" aria-label="Company and legal policies">
            <h2>Company</h2>
            <a href={`${home}/frontend/src/html/about.html`}>About Study Hub</a>
            <a href="mailto:trusteth777@gmail.com">Contact</a>
            <a href={`${home}/documentation.html`}>Documentation</a>
            <a href={`${home}/legal.html`}>Legal</a>
          </nav>
          <div class="legacy-footer-bottom">
            <span>© {new Date().getFullYear()} Study Hub</span>
            <a href="#top">Back to top <span aria-hidden="true">↑</span></a>
          </div>
        </div>
      </footer>
    )}
    <ResumeProgress />
  </body>
</html>