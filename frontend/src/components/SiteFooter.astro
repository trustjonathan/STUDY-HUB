---
import { availableSubjects } from '../data/availableSubjects';

interface Props {
  home: string;
}

const { home } = Astro.props;
const featuredSubjects = availableSubjects.slice(0, 6);
---

<footer class="site-footer legacy-site-footer" id="footer-links">
  <div class="legacy-footer-inner">
    <div class="legacy-footer-brand">
      <a class="legacy-footer-mark" href={home} aria-label="Study Hub home">
        <img src={`${home}/favicon.svg`} width="46" height="46" alt="" />
      </a>
      <nav class="legacy-footer-socials" aria-label="Contact Study Hub">
        <a href="https://wa.me/256701810497" aria-label="Contact Study Hub on WhatsApp" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 11.8a8.5 8.5 0 0 1-12.6 7.4L3 20.5l1.4-4.7a8.5 8.5 0 1 1 16.1-4ZM9 8.2c.2-.4.4-.4.7-.4h.5c.2 0 .4.1.5.4l.8 1.9c.1.2.1.4-.1.6l-.6.7c-.2.2-.2.4-.1.6.5.9 1.2 1.5 2.1 1.9.2.1.4 0 .6-.2l.8-.9c.2-.2.4-.2.6-.1l1.8.9c.2.1.3.3.3.5 0 .3-.2 1.1-.7 1.5-.5.5-1.2.7-2 .6-1.1-.1-2.4-.7-3.7-1.8-1.1-1-1.9-2.2-2.2-3.2-.3-1 .1-2 .7-3Z" /></svg>
        </a>
        <a href="mailto:trusteth777@gmail.com" aria-label="Email Study Hub">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></svg>
        </a>
      </nav>
    </div>

    <details class="legacy-footer-column legacy-footer-disclosure" data-footer-disclosure open>
      <summary><span>Featured subjects</span></summary>
      <nav class="legacy-footer-subject-grid" aria-label="Featured subjects">
        {featuredSubjects.map((subject) => (
          <a href={`${home}/frontend/src/html/${subject.slug}`}>{subject.name}</a>
        ))}
        <a class="legacy-footer-all-subjects" href={`${home}/subjects.html`}>All subjects <span aria-hidden="true">→</span></a>
      </nav>
    </details>

    <details class="legacy-footer-column legacy-footer-disclosure" data-footer-disclosure open>
      <summary><span>Study tools</span></summary>
      <nav aria-label="Study tools">
        <a href={`${home}/library.html`}>Study library</a>
        <a href={`${home}/study.html`}>AI Study</a>
        <a href={`${home}/learn.html`}>AI Study Guides</a>
        <a href={`${home}/library-guide.html`}>Library guide</a>
        <a href={`${home}/blog.html`}>Study Hub Blog</a>
        <a href={`${home}/community-chat.html`}>Suggestions</a>
      </nav>
    </details>

    <details class="legacy-footer-column legacy-footer-disclosure" data-footer-disclosure open>
      <summary><span>About &amp; contact</span></summary>
      <nav aria-label="About and contact">
        <a href={`${home}/frontend/src/html/about.html`}>About Study Hub</a>
        <a href="mailto:trusteth777@gmail.com">Contact us</a>
        <a href={`${home}/ads-and-partnerships.html`}>Ads &amp; partnerships</a>
      </nav>
    </details>

  </div>
</footer>

<script>
  const footerMobileMedia = window.matchMedia('(max-width: 760px)');

  function syncFooterDisclosureState(): void {
    const disclosures = document.querySelectorAll<HTMLDetailsElement>('[data-footer-disclosure]');
    if (!disclosures.length) return;

    disclosures.forEach((disclosure) => {
      disclosure.open = !footerMobileMedia.matches;
    });
  }

  footerMobileMedia.addEventListener('change', syncFooterDisclosureState);
  document.addEventListener('astro:page-load', syncFooterDisclosureState);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', syncFooterDisclosureState, { once: true });
  } else {
    syncFooterDisclosureState();
  }
</script>
