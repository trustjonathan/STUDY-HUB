---
import subjectCatalog from "../data/subjects.json";
import subjectGuides from "../data/subjectGuides.json";
import subjectMethods from "../data/subjectMethods.json";
import LibraryWorkspace from "./LibraryWorkspace";
import "../styles/library.css";

interface SubjectGuide {
  overview: string;
  topicAreas: string[];
  levelGuides: Record<string, { focus: string; example: string }>;
}

interface SubjectMethod {
  title: string;
  steps: string[];
  checkpoint: string;
}

interface Props {
  subject: string;
  name: string;
  headline: string;
  description: string;
  icon: string;
}

const { subject, name, headline, description, icon } = Astro.props;
const subjectInfo = subjectCatalog.find((entry) => entry.slug === subject);
if (!subjectInfo) throw new Error(`Unknown Study Hub subject: ${subject}`);
const subjectGuide = (subjectGuides as Record<string, SubjectGuide>)[subject];
if (!subjectGuide) throw new Error(`Missing subject revision guide: ${subject}`);
const subjectMethod = (subjectMethods as Record<string, SubjectMethod>)[subject];
if (!subjectMethod) throw new Error(`Missing subject study method: ${subject}`);
const categoryLabels: Record<string, string> = {
  "sciences-math": "Science & mathematics",
  languages: "Languages",
  "humanities-social": "Humanities & society",
  "applied-technical": "Applied & technical",
  "business-economics": "Business & economics",
};
const subjectCategory = categoryLabels[subjectInfo.category] || "Subject guide";
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const home = base.replace(/\/$/, "");
const libraryId = `${subject}-library`;
const fullLibraryHref = `${base}library.html?class=all&subject=${encodeURIComponent(subject)}`;
const assistantHref = `${base}assistant.html?subject=${encodeURIComponent(subject)}`;
const supabaseUrl = (import.meta.env.PUBLIC_SUPABASE_URL || "").trim();
const anonKey = (import.meta.env.PUBLIC_SUPABASE_ANON_KEY || "").trim();
const apiUrl = (import.meta.env.PUBLIC_STUDY_HUB_API_URL || "").trim();
---

<main class="subject-dashboard" id="main-content" tabindex="-1" data-subject={subject}>
  <section class="subject-hero" aria-labelledby={`${subject}-title`}>
    <div class="subject-hero-copy">
      <p class="subject-eyebrow">{subjectCategory} <span aria-hidden="true">/</span> {name}</p>
      <h1 id={`${subject}-title`}>{headline}</h1>
      <p class="subject-hero-description">{description}</p>
      <div class="subject-hero-actions">
        <a class="subject-button subject-button-primary" href={`#${libraryId}`}>Browse resources <span aria-hidden="true">→</span></a>
        <a class="subject-button subject-button-secondary" href={assistantHref}>Open AI Study <span aria-hidden="true">↗</span></a>
      </div>
      <p class="subject-hero-context">{subjectInfo.levels.join(" · ")} <span aria-hidden="true">/</span> A practical revision map</p>
    </div>
    <div class="subject-hero-art" aria-label={`${name} study lens: ${subjectMethod.title}`}>
      <span class="subject-art-ring subject-art-ring-outer" aria-hidden="true"></span>
      <span class="subject-art-ring subject-art-ring-inner" aria-hidden="true"></span>
      <span class="subject-art-icon" aria-hidden="true">{icon}</span>
      <span class="subject-art-caption">Study lens</span>
      <strong>{subjectMethod.title}</strong>
    </div>
  </section>

  <section class="subject-section subject-levels" aria-labelledby={`${subject}-levels-heading`}>
    <div class="subject-section-heading">
      <p class="subject-eyebrow">Choose your starting point</p>
      <h2 id={`${subject}-levels-heading`}>Study focus by level</h2>
    </div>
    <div class="subject-level-grid">
      {subjectInfo.levels.map((level) => {
        const levelGuide = subjectGuide.levelGuides[level];
        return levelGuide && (
          <article class="subject-level-card">
            <p class="subject-card-label">{level}</p>
            <h3>{levelGuide.focus}</h3>
            <p class="subject-level-example"><strong>Try:</strong> {levelGuide.example}</p>
          </article>
        );
      })}
    </div>
  </section>

  <section class="subject-section subject-route" aria-labelledby={`${subject}-route-heading`}>
    <div class="subject-route-intro">
      <p class="subject-eyebrow">Revision map</p>
      <h2 id={`${subject}-route-heading`}>A route through {name}</h2>
      <p>{subjectGuide.overview}</p>
    </div>
    <ol class="subject-route-list" aria-label={`${name} topic route`}>
      {subjectGuide.topicAreas.map((topic, index) => (
        <li>
          <span class="subject-route-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          <h3>{topic}</h3>
        </li>
      ))}
    </ol>
    <p class="subject-disclaimer">Use this map as a starting point, not a complete or official syllabus. Follow your current class work and your teacher’s latest guidance.</p>
  </section>

  <section class="subject-section subject-method" aria-labelledby={`${subject}-method-heading`}>
    <div class="subject-method-intro">
      <p class="subject-eyebrow">A practice move for this subject</p>
      <h2 id={`${subject}-method-heading`}>{subjectMethod.title}</h2>
    </div>
    <ol class="subject-method-steps">
      {subjectMethod.steps.map((step, index) => (
        <li><span>{index + 1}</span><p>{step}</p></li>
      ))}
    </ol>
    <aside class="subject-checkpoint">
      <span aria-hidden="true">↗</span>
      <p><strong>Check your understanding</strong>{subjectMethod.checkpoint}</p>
    </aside>
  </section>

  <section class="subject-section subject-resources" id={libraryId} aria-labelledby={`${subject}-resources-heading`}>
    <div class="subject-resources-heading">
      <div>
        <p class="subject-eyebrow">Shared Study Hub catalogue</p>
        <h2 id={`${subject}-resources-heading`}>{name} resources</h2>
        <p>Browse a short preview, or open the full Library with this subject already selected.</p>
      </div>
      <a class="subject-library-link" href={fullLibraryHref}>View all {name} resources <span aria-hidden="true">→</span></a>
    </div>
    <LibraryWorkspace
      client:load
      homeHref={home}
      supabaseUrl={supabaseUrl}
      anonKey={anonKey}
      apiUrl={apiUrl}
      embedded={true}
      subjectPreview={true}
      initialClass="all"
      initialSubject={subject}
    />
  </section>
</main>

<script is:inline src={`${base}scripts/dashboard-previews.js`} defer></script>

<style>
  .subject-dashboard {
    display: grid;
    gap: clamp(24px, 4vw, 40px);
    width: min(1180px, 100%);
    margin: 28px auto 40px;
    padding: 0 clamp(16px, 3vw, 28px);
    color: var(--color-ink);
    font-family: var(--font-sans);
  }
  .subject-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(180px, 280px);
    align-items: center;
    gap: clamp(24px, 5vw, 64px);
    min-height: 300px;
    overflow: hidden;
    padding: clamp(26px, 5vw, 54px);
    border: 1px solid var(--color-workspace-line);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(ellipse at 87% 14%, var(--color-workspace-raised), transparent 42%),
      var(--color-workspace);
    color: var(--color-workspace-text);
  }
  .subject-hero-copy { position: relative; z-index: 1; max-width: 700px; }
  .subject-eyebrow {
    margin: 0 0 9px;
    color: var(--color-primary);
    font: 800 var(--text-xs)/1.4 var(--font-display);
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .subject-hero .subject-eyebrow { color: var(--color-workspace-accent); }
  .subject-eyebrow span { padding: 0 5px; color: var(--color-muted); }
  .subject-hero .subject-eyebrow span { color: var(--color-workspace-muted); }
  .subject-hero h1 {
    max-width: 690px;
    margin: 0;
    color: var(--color-workspace-text);
    font: 800 clamp(2rem, 5vw, 3.45rem)/1.08 var(--font-display);
    letter-spacing: -.035em;
  }
  .subject-hero-description {
    max-width: 620px;
    margin: 15px 0 0;
    color: var(--color-workspace-muted);
    font-size: var(--text-md);
    line-height: 1.65;
  }
  .subject-hero-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 23px; }
  .subject-button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 0 15px;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 800;
    text-decoration: none;
  }
  .subject-button-primary { background: var(--color-primary); color: var(--color-on-primary); }
  .subject-button-primary:hover { background: var(--color-primary-hover); }
  .subject-button-secondary { border-color: var(--color-workspace-line); color: var(--color-workspace-text); }
  .subject-button-secondary:hover { background: var(--color-workspace-surface); }
  .subject-button:focus-visible, .subject-library-link:focus-visible {
    outline: 3px solid var(--color-workspace-accent);
    outline-offset: 3px;
  }
  .subject-hero-context { margin: 16px 0 0; color: var(--color-workspace-muted); font-size: var(--text-xs); }
  .subject-hero-context span { padding: 0 5px; color: var(--color-workspace-accent); }
  .subject-hero-art {
    position: relative;
    display: flex;
    min-height: 220px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 32px 16px;
    border: 1px solid var(--color-workspace-line);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-workspace-surface) 72%, transparent);
    text-align: center;
  }
  .subject-art-ring { position: absolute; width: 130px; height: 130px; border: 1px solid var(--color-workspace-line); border-radius: 50%; }
  .subject-art-ring-outer { width: 178px; height: 178px; opacity: .48; }
  .subject-art-ring-inner { width: 112px; height: 112px; border-color: var(--color-workspace-accent); opacity: .65; }
  .subject-art-icon { position: relative; z-index: 1; margin: -6px 0 10px; color: var(--color-workspace-text); font-size: 2.4rem; line-height: 1; }
  .subject-art-caption { position: relative; z-index: 1; color: var(--color-workspace-accent); font-size: .68rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
  .subject-hero-art strong { position: relative; z-index: 1; max-width: 200px; margin-top: 6px; color: var(--color-workspace-text); font: 700 var(--text-sm)/1.4 var(--font-display); }
  .subject-section { min-width: 0; }
  .subject-section-heading { margin-bottom: 14px; }
  .subject-section-heading h2, .subject-route-intro h2, .subject-method-intro h2, .subject-resources h2 {
    margin: 0;
    color: var(--color-ink);
    font: 800 clamp(1.35rem, 2.7vw, 1.85rem)/1.2 var(--font-display);
    letter-spacing: -.025em;
  }
  .subject-level-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 12px; }
  .subject-level-card {
    min-width: 0;
    padding: 19px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
    box-shadow: var(--shadow-soft);
  }
  .subject-card-label { margin: 0 0 9px; color: var(--color-primary); font-size: var(--text-xs); font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .subject-level-card h3 { margin: 0; color: var(--color-ink); font: 750 var(--text-lg)/1.3 var(--font-display); }
  .subject-level-example { margin: 12px 0 0; color: var(--color-muted); font-size: var(--text-sm); line-height: 1.6; }
  .subject-level-example strong { color: var(--color-ink-soft); }
  .subject-route {
    display: grid;
    grid-template-columns: minmax(220px, .7fr) minmax(0, 1.3fr);
    gap: 18px 34px;
    padding: clamp(20px, 4vw, 30px);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }
  .subject-route-intro p:not(.subject-eyebrow) { margin: 12px 0 0; color: var(--color-muted); font-size: var(--text-sm); line-height: 1.7; }
  .subject-route-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .subject-route-list li {
    display: flex;
    min-width: 0;
    align-items: flex-start;
    gap: 12px;
    padding: 14px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: var(--color-surface-raised);
  }
  .subject-route-number { flex: 0 0 auto; color: var(--color-primary); font: 800 var(--text-xs)/1.5 var(--font-display); }
  .subject-route-list h3 { margin: 0; color: var(--color-ink-soft); font: 700 var(--text-sm)/1.45 var(--font-display); overflow-wrap: anywhere; }
  .subject-disclaimer { grid-column: 1 / -1; margin: 0; color: var(--color-muted); font-size: var(--text-xs); line-height: 1.6; }
  .subject-method {
    display: grid;
    grid-template-columns: minmax(190px, .75fr) minmax(0, 1.6fr);
    align-items: start;
    gap: 16px 34px;
    padding: clamp(20px, 4vw, 30px);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius-sm) var(--radius-md) var(--radius-md) var(--radius-sm);
    background: var(--color-success-surface);
  }
  .subject-method-intro .subject-eyebrow { color: var(--color-success); }
  .subject-method-steps { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .subject-method-steps li { display: flex; align-items: flex-start; gap: 12px; }
  .subject-method-steps li > span {
    display: grid;
    width: 26px;
    height: 26px;
    flex: 0 0 26px;
    place-items: center;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-size: var(--text-xs);
    font-weight: 800;
  }
  .subject-method-steps p { margin: 2px 0 0; color: var(--color-ink-soft); font-size: var(--text-sm); line-height: 1.6; }
  .subject-checkpoint {
    display: flex;
    grid-column: 2;
    gap: 12px;
    padding: 14px;
    border: 1px solid color-mix(in srgb, var(--color-primary) 22%, var(--color-line));
    border-radius: var(--radius-sm);
    background: var(--color-surface);
  }
  .subject-checkpoint > span { flex: 0 0 auto; color: var(--color-primary); font-size: var(--text-lg); font-weight: 800; }
  .subject-checkpoint p { display: grid; gap: 4px; margin: 0; color: var(--color-ink-soft); font-size: var(--text-sm); line-height: 1.5; }
  .subject-checkpoint strong { color: var(--color-ink); font-family: var(--font-display); }
  .subject-resources { scroll-margin-top: 92px; }
  .subject-resources-heading { display: flex; align-items: end; justify-content: space-between; gap: 16px; margin-bottom: 14px; }
  .subject-resources-heading > div { max-width: 66ch; }
  .subject-resources-heading > div > p:last-child { margin: 8px 0 0; color: var(--color-muted); font-size: var(--text-sm); line-height: 1.55; }
  .subject-library-link { display: inline-flex; min-height: 44px; flex: 0 0 auto; align-items: center; gap: 9px; color: var(--color-primary); font-size: var(--text-sm); font-weight: 800; text-decoration: none; }
  .subject-library-link:hover { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 760px) {
    .subject-dashboard { margin-top: 16px; }
    .subject-hero { grid-template-columns: minmax(0, 1fr) 150px; gap: 18px; min-height: 0; }
    .subject-hero-art { min-height: 180px; }
    .subject-art-ring-outer { width: 148px; height: 148px; }
    .subject-art-ring-inner { width: 100px; height: 100px; }
    .subject-route { grid-template-columns: 1fr; }
    .subject-method { grid-template-columns: 1fr; }
    .subject-checkpoint { grid-column: 1; }
  }
  @media (max-width: 520px) {
    .subject-hero { grid-template-columns: 1fr; padding: 22px; }
    .subject-hero-art { min-height: 150px; }
    .subject-art-ring-outer { width: 130px; height: 130px; }
    .subject-route-list { grid-template-columns: 1fr; }
    .subject-resources-heading { align-items: flex-start; flex-direction: column; }
  }
</style>
