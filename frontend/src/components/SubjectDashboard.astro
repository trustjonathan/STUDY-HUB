---
import subjectCatalog from "../data/subjects.json";
import subjectGuides from "../data/subjectGuides.json";
import LibraryWorkspace from "./LibraryWorkspace";
import "../styles/library.css";

interface SubjectGuide {
  overview: string;
  topicAreas: string[];
  levelGuides: Record<string, { focus: string; example: string }>;
}

interface Props {
  subject: string;
  name: string;
  headline: string;
  description: string;
  icon: string;
}

const { subject, name, headline, description, icon } = Astro.props;
const subjectInfo = subjectCatalog.find((entry) => entry.slug === subject);
if (!subjectInfo) throw new Error(`Unknown Study Hub subject: ${subject}`);
const subjectGuide = (subjectGuides as Record<string, SubjectGuide>)[subject];
if (!subjectGuide) throw new Error(`Missing subject revision guide: ${subject}`);
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const home = base.replace(/\/$/, "");
const libraryId = `${subject}-library`;
const fullLibraryHref = `${base}library.html?class=all&subject=${encodeURIComponent(subject)}`;
const assistantHref = `${base}assistant.html?subject=${encodeURIComponent(subject)}`;
const supabaseUrl = (import.meta.env.PUBLIC_SUPABASE_URL || "").trim();
const anonKey = (import.meta.env.PUBLIC_SUPABASE_ANON_KEY || "").trim();
const apiUrl = (import.meta.env.PUBLIC_STUDY_HUB_API_URL || "").trim();
---

<main class="subject-dashboard" id="main-content" tabindex="-1" data-subject={subject}>
  <section class="dashboard-hero">
    <div class="dashboard-welcome">
      <p class="dashboard-eyebrow">Study Hub · {name}</p>
      <h1>{headline}</h1>
      <p>{description}</p>
      <div class="dashboard-hero-actions">
        <a class="dashboard-primary" href={`#${libraryId}`}>Explore {name} resources <span aria-hidden="true">→</span></a>
        <a class="dashboard-ai-link" href={assistantHref}>Ask AI Study about {name}</a>
        <span class="dashboard-public-note">Free resources, open to everyone</span>
      </div>
    </div>
    <div class="dashboard-subject-mark" aria-hidden="true">
      <span>{icon}</span>
      <small>{name.toUpperCase()}</small>
    </div>
  </section>

  <section class="dashboard-section curriculum-overview" aria-labelledby={`${subject}-curriculum-heading`}>
    <div class="dashboard-section-heading">
      <div><p class="dashboard-eyebrow">Revision map · {subjectInfo.levels.join(" · ")}</p><h2 id={`${subject}-curriculum-heading`}>A guide to {name}</h2></div>
    </div>
    <div class="curriculum-details">
      <p class="curriculum-summary">{subjectGuide.overview}</p>
      <div class="curriculum-topic-list" aria-label={`${name} topic areas`}>
        {subjectGuide.topicAreas.map((topic) => <span>{topic}</span>)}
      </div>
      <p><strong>Curriculum track</strong><span>{subjectInfo.tracks.join(" · ")}</span></p>
      {subjectInfo.codes.length > 0 && (
        <p><strong>UNEB subject code</strong><span>{subjectInfo.codes.map(({ level, code }) => `${level}: ${code}`).join(" · ")}</span></p>
      )}
      <p class="curriculum-note">This is a practical revision map, not a complete or official syllabus. Follow your current school scheme of work and check the latest guidance from your teacher.</p>
    </div>
  </section>

  <section class="dashboard-section dashboard-learning-path" aria-labelledby={`${subject}-learning-heading`}>
    <div class="dashboard-section-heading">
      <div><p class="dashboard-eyebrow">Study with purpose</p><h2 id={`${subject}-learning-heading`}>How to make progress in {name}</h2></div>
    </div>
    <div class="dashboard-learning-copy">
      <p>Use the topic map above to choose one area that matches your current class work. Read an explanation actively, note the step or idea that is least clear, and try to restate it in your own words before moving on.</p>
      <p>For a practical check, try the example below for your study level without looking at a worked answer first. Show your reasoning, then compare it with your notes. Keep a short list of errors or questions to revisit; a specific gap is easier to address than rereading a whole unit.</p>
      <p>When you are ready, use past-paper questions to practise applying what you have learned. Exam materials and classroom schemes can change, so use your teacher’s current guidance when deciding which topics and requirements to prioritise.</p>
    </div>
    <div class="dashboard-level-guides">
      {subjectInfo.levels.map((level) => {
        const levelGuide = subjectGuide.levelGuides[level];
        return levelGuide && (
          <article class="dashboard-level-guide">
            <h3>{level} study focus</h3>
            <p>{levelGuide.focus}</p>
            <p><strong>Try this:</strong> {levelGuide.example}</p>
          </article>
        );
      })}
    </div>
    <nav class="dashboard-learning-links" aria-label={`${name} study links`}>
      <a href={`#${libraryId}`}>Browse notes and practice materials <span aria-hidden="true">↓</span></a>
      <a href={fullLibraryHref}>Open this subject in the full Library <span aria-hidden="true">→</span></a>
      <a href={assistantHref}>Ask AI Study about {name} <span aria-hidden="true">→</span></a>
    </nav>
  </section>

  <section class="dashboard-section dashboard-library" id={libraryId} aria-labelledby={`${subject}-library-heading`}>
    <div class="dashboard-section-heading">
      <div>
        <p class="dashboard-eyebrow">Shared Study Hub catalogue</p>
        <h2 id={`${subject}-library-heading`}>{name} resources</h2>
        <p>Search the same catalogue used by the full Library. Resource availability can differ by class and topic.</p>
      </div>
      <a href={fullLibraryHref}>Open full Library <span aria-hidden="true">→</span></a>
    </div>
    <div class="dashboard-library-workspace">
      <LibraryWorkspace
        client:load
        homeHref={home}
        supabaseUrl={supabaseUrl}
        anonKey={anonKey}
        apiUrl={apiUrl}
        embedded={true}
        initialClass="all"
        initialSubject={subject}
      />
    </div>
  </section>
</main>

<script is:inline src={`${base}scripts/dashboard-previews.js`} defer></script>

<style>
  .subject-dashboard {
    --dashboard-accent: #28634f;
    --dashboard-accent-soft: #e8f2eb;
    max-width: 1180px;
    margin: 28px auto 20px;
    padding: 0 28px;
    color: #192b3b;
    font-family: "DM Sans", Arial, sans-serif;
  }
  .subject-dashboard[data-subject="chemistry"] { --dashboard-accent: #94621c; --dashboard-accent-soft: #fff3dc; }
  .subject-dashboard[data-subject="mathematics"] { --dashboard-accent: #315c91; --dashboard-accent-soft: #eaf1fb; }
  .subject-dashboard[data-subject="physics"] { --dashboard-accent: #286d7a; --dashboard-accent-soft: #e5f3f4; }
  .dashboard-hero {
    position: relative;
    display: flex;
    min-height: 240px;
    align-items: center;
    justify-content: space-between;
    overflow: hidden;
    padding: 38px clamp(24px, 5vw, 58px);
    border-radius: 18px;
    background: radial-gradient(circle at 85% 20%, rgba(255,255,255,.13), transparent 26%), linear-gradient(125deg, #102a42, #1c4058);
    color: white;
  }
  .dashboard-welcome { position: relative; z-index: 1; max-width: 680px; }
  .dashboard-eyebrow { margin: 0 0 8px; color: var(--dashboard-accent); font-size: .72rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .dashboard-hero .dashboard-eyebrow { color: #b8daca; }
  .dashboard-hero h1 { max-width: 660px; margin: 0; color: #fff; font-family: Manrope, Arial, sans-serif; font-size: clamp(2rem, 4.2vw, 3.5rem); line-height: 1.08; }
  .dashboard-hero p:not(.dashboard-eyebrow) { max-width: 620px; margin: 14px 0 0; color: rgba(255,255,255,.77); }
  .dashboard-hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin-top: 22px; }
  .dashboard-primary { display: inline-flex; min-height: 44px; align-items: center; gap: 16px; padding: 0 17px; border-radius: 7px; background: #f0b642; color: #1b2d3d; font-size: .88rem; font-weight: 800; text-decoration: none; }
  .dashboard-primary:hover { background: #ffca62; }
  .dashboard-ai-link { color: #fff; font-size: .84rem; font-weight: 800; text-decoration: underline; text-underline-offset: 3px; }
  .dashboard-ai-link:focus-visible { outline: 3px solid #f0b642; outline-offset: 3px; }
  .dashboard-public-note { color: rgba(255,255,255,.68); font-size: .82rem; }
  .dashboard-subject-mark { display: grid; width: 150px; height: 150px; flex: 0 0 auto; align-content: center; justify-items: center; gap: 8px; margin-left: 30px; border: 1px solid rgba(255,255,255,.2); border-radius: 50%; background: rgba(255,255,255,.06); }
  .dashboard-subject-mark span { font-size: 3.8rem; line-height: 1; }
  .dashboard-subject-mark small { color: #c6d6df; font-size: .65rem; font-weight: 800; letter-spacing: .16em; }
  .dashboard-section { margin: 28px 0; }
  .curriculum-overview, .dashboard-learning-path { padding: 20px 22px; border: 1px solid #e0e6e9; border-radius: 12px; background: #fff; }
  .curriculum-overview .dashboard-section-heading { margin-bottom: 12px; }
  .curriculum-details { display: flex; flex-wrap: wrap; gap: 12px 28px; }
  .curriculum-details > p { display: grid; gap: 2px; margin: 0; color: #657483; font-size: .82rem; }
  .curriculum-details > .curriculum-summary { display: block; flex-basis: 100%; color: #435465; font-size: .94rem; line-height: 1.65; }
  .curriculum-topic-list { display: flex; flex-basis: 100%; flex-wrap: wrap; gap: 8px; }
  .curriculum-topic-list span { padding: 7px 10px; border-radius: 999px; background: var(--dashboard-accent-soft); color: var(--dashboard-accent); font-size: .76rem; font-weight: 700; }
  .curriculum-details strong { color: #213448; font-size: .76rem; }
  .curriculum-details .curriculum-note { flex-basis: 100%; margin-top: 4px; }
  .dashboard-section-heading { display: flex; align-items: end; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  .dashboard-section-heading .dashboard-eyebrow { margin-bottom: 4px; }
  .dashboard-section-heading h2 { margin: 0; font-family: Manrope, Arial, sans-serif; font-size: clamp(1.3rem, 2vw, 1.7rem); }
  .dashboard-section-heading > a { color: var(--dashboard-accent); font-size: .82rem; font-weight: 800; text-decoration: none; white-space: nowrap; }
  .dashboard-section-heading > a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .dashboard-learning-copy { display: grid; max-width: 920px; gap: 14px; color: #4f5f6c; font-size: .93rem; line-height: 1.75; }
  .dashboard-learning-copy p { margin: 0; }
  .dashboard-level-guides { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 12px; margin-top: 18px; }
  .dashboard-level-guide { padding: 16px; border: 1px solid #e0e6e9; border-radius: 10px; background: #f8faf9; }
  .dashboard-level-guide h3 { margin: 0 0 8px; color: #213448; font-size: .95rem; }
  .dashboard-level-guide p { margin: 0; color: #4f5f6c; font-size: .86rem; line-height: 1.6; }
  .dashboard-level-guide p + p { margin-top: 10px; }
  .dashboard-level-guide p strong { color: #213448; }
  .dashboard-learning-links { display: flex; flex-wrap: wrap; gap: 10px 20px; margin-top: 18px; }
  .dashboard-learning-links a { color: var(--dashboard-accent); font-size: .84rem; font-weight: 800; text-decoration: none; }
  .dashboard-learning-links a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .dashboard-library { padding: 20px; border: 1px solid #dfe6e2; border-radius: 12px; background: #f8faf9; }
  .dashboard-library .dashboard-section-heading > div { max-width: 72ch; }
  .dashboard-library .dashboard-section-heading p:not(.dashboard-eyebrow) { margin: 8px 0 0; color: #526273; font-size: .84rem; line-height: 1.5; }
  .dashboard-library-workspace { height: min(940px, 88vh); min-height: 680px; overflow: hidden; border: 1px solid #334155; border-radius: 10px; background: #0b1220; }
  @media (max-width: 760px) {
    .subject-dashboard { margin-top: 16px; padding: 0 16px; }
    .dashboard-hero { min-height: 215px; padding: 28px 24px; }
    .dashboard-subject-mark { width: 92px; height: 92px; margin-left: 12px; }
    .dashboard-subject-mark span { font-size: 2.6rem; }
    .dashboard-section-heading { align-items: center; flex-wrap: wrap; }
  }
  @media (max-width: 480px) {
    .dashboard-hero { align-items: flex-start; padding: 24px 18px; }
    .dashboard-subject-mark { width: 56px; height: 56px; border: 0; background: transparent; }
    .dashboard-subject-mark span { font-size: 2rem; }
    .dashboard-subject-mark small { display: none; }
    .dashboard-hero-actions { gap: 10px; }
    .dashboard-public-note { width: 100%; }
    .dashboard-learning-path { padding: 18px; }
    .dashboard-library { padding: 12px; }
    .dashboard-library-workspace { height: 78vh; min-height: 620px; }
  }
</style>
