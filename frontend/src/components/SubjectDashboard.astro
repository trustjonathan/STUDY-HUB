---
import resourceManifest from "../data/resources.json";
import subjectCatalog from "../data/subjects.json";

interface Props {
  subject: string;
  name: string;
  headline: string;
  description: string;
  icon: string;
}

const { subject, name, headline, description, icon } = Astro.props;
const subjectInfo = subjectCatalog.find((entry) => entry.slug === subject);
if (!subjectInfo) throw new Error(`Unknown Study Hub subject: ${subject}`);
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const libraryId = `${subject}-library`;
const subjectSlugs = [subject, subjectInfo.storageFolder, ...subjectInfo.folderAliases];
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || "";
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "";
const allResources = resourceManifest.items.filter((item) => subjectSlugs.includes(item.subject));
const notes = allResources.filter((item) => item.category === "notes");
const papers = allResources.filter((item) => item.category === "papers");
const recentlyAdded = [...allResources]
  .sort((left, right) => Date.parse(right.updatedAt || "") - Date.parse(left.updatedAt || ""))
  .slice(0, 4);
const featured = (notes.length ? notes : papers).slice(0, 4);
const levels = new Set(allResources.map((item) => item.level).filter(Boolean));

function readerHref(item: (typeof allResources)[number]) {
  const query = new URLSearchParams({
    file: item.publicUrl,
    title: item.title || item.originalFilename || `${name} resource`,
    return: `${base}frontend/src/html/${subject}.html`,
  });
  if (supabaseAnonKey) query.set("anon_key", supabaseAnonKey);
  if (turnstileSiteKey) query.set("turnstile_key", turnstileSiteKey);
  return `${base}full_page_flipbook_viewer/index.html?${query}`;
}

function itemLabel(item: (typeof allResources)[number]) {
  return [item.level, item.year, item.resourceType === "guide" ? "Guide" : item.category === "notes" ? "Notes" : "Study resource"]
    .filter(Boolean)
    .join(" · ");
}

const subjects = subjectCatalog;
---

<main class="subject-dashboard" data-subject={subject}>
  <section class="dashboard-hero">
    <div class="dashboard-welcome">
      <p class="dashboard-eyebrow">Study Hub · {name}</p>
      <h1>{headline}</h1>
      <p>{description}</p>
      <div class="dashboard-hero-actions">
        <a class="dashboard-primary" href={`#${libraryId}`}>Explore {name} resources <span aria-hidden="true">→</span></a>
        <span class="dashboard-public-note">Free resources, open to everyone</span>
      </div>
    </div>
    <div class="dashboard-subject-mark" aria-hidden="true">
      <span>{icon}</span>
      <small>{name.toUpperCase()}</small>
    </div>
  </section>

  <section class="dashboard-stats" aria-label={`${name} library statistics`}>
    <div class="dashboard-stat">
      <span class="dashboard-stat-icon">▤</span>
      <div><strong>{allResources.length}</strong><span>Resources</span></div>
    </div>
    <div class="dashboard-stat">
      <span class="dashboard-stat-icon">✎</span>
      <div><strong>{notes.length}</strong><span>Study notes</span></div>
    </div>
    <div class="dashboard-stat">
      <span class="dashboard-stat-icon">✓</span>
      <div><strong>{papers.length}</strong><span>Past papers</span></div>
    </div>
    <div class="dashboard-stat">
      <span class="dashboard-stat-icon">⌂</span>
      <div><strong>{levels.size}</strong><span>Study levels</span></div>
    </div>
  </section>

  <section class="dashboard-section curriculum-overview" aria-labelledby={`${subject}-curriculum-heading`}>
    <div class="dashboard-section-heading">
      <div><p class="dashboard-eyebrow">UNEB / NCDC curriculum</p><h2 id={`${subject}-curriculum-heading`}>Subject overview</h2></div>
    </div>
    <div class="curriculum-details">
      <p><strong>Study levels</strong><span>{subjectInfo.levels.join(" · ")}</span></p>
      <p><strong>Curriculum track</strong><span>{subjectInfo.tracks.join(" · ")}</span></p>
      {subjectInfo.codes.length > 0 && (
        <p><strong>UNEB subject code</strong><span>{subjectInfo.codes.map(({ level, code }) => `${level}: ${code}`).join(" · ")}</span></p>
      )}
      <p class="curriculum-note">Resources are added as they become available. Check back for notes and exam papers.</p>
    </div>
  </section>

  <nav class="dashboard-library-links" aria-label={`${name} resource collections`}>
    <button class="toggle-btn" type="button" data-target="notes-content" aria-controls="notes-content" aria-expanded="false">Browse notes</button>
    <button class="toggle-btn" type="button" data-target="papers-content" aria-controls="papers-content" aria-expanded="false">Browse past papers</button>
  </nav>

  {recentlyAdded.length > 0 && (
    <section class="dashboard-section" aria-labelledby={`${subject}-recent-heading`}>
      <div class="dashboard-section-heading">
        <div><p class="dashboard-eyebrow">Fresh from the library</p><h2 id={`${subject}-recent-heading`}>Recently added</h2></div>
        <a href={`#${libraryId}`}>Browse all <span aria-hidden="true">→</span></a>
        <div class="dashboard-carousel-controls" aria-label="Recently added resource controls">
          <button type="button" data-carousel-target={`${subject}-recent-carousel`} data-carousel-direction="-1" aria-label="Scroll recently added resources left" title="Scroll left">←</button>
          <button type="button" data-carousel-target={`${subject}-recent-carousel`} data-carousel-direction="1" aria-label="Scroll recently added resources right" title="Scroll right">→</button>
        </div>
      </div>
      <div class="dashboard-resource-grid dashboard-carousel-track" id={`${subject}-recent-carousel`} tabindex="0" aria-label={`Recently added ${name} resources`}>
        {recentlyAdded.map((item) => (
          <a class="dashboard-resource-card" href={readerHref(item)} aria-label={`Open ${item.title || item.originalFilename}`}>
            <span class="dashboard-preview" data-preview-url={["pdf", "docx", "png", "jpg", "jpeg", "webp"].includes(item.extension || "") ? item.publicUrl : undefined} data-preview-format={item.extension} data-preview-worker={`${base}full_page_flipbook_viewer/js/pdf.worker.min.js`} aria-hidden="true">
              <span class="dashboard-preview-placeholder">{item.resourceType === "paper" ? "✍" : icon}</span>
              {["pdf", "docx", "png", "jpg", "jpeg", "webp"].includes(item.extension || "") && <span class="dashboard-preview-caption">Loading page preview…</span>}
              {!["pdf", "docx", "png", "jpg", "jpeg", "webp"].includes(item.extension || "") && <span class="dashboard-preview-caption">{item.extension?.toUpperCase() || "FILE"} · Open to view</span>}
            </span>
            <span class="dashboard-resource-copy">
              <span class="dashboard-card-title">{item.title || item.originalFilename}</span>
              <span class="dashboard-card-meta">{itemLabel(item)}</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  )}

  {featured.length > 0 && (
    <section class="dashboard-section" aria-labelledby={`${subject}-featured-heading`}>
      <div class="dashboard-section-heading">
        <div><p class="dashboard-eyebrow">{notes.length ? "Start with the essentials" : "Practice and prepare"}</p><h2 id={`${subject}-featured-heading`}>{notes.length ? "Study notes" : "Explore past papers"}</h2></div>
        <button class="dashboard-text-button toggle-btn" type="button" data-target={notes.length ? "notes-content" : "papers-content"} aria-controls={notes.length ? "notes-content" : "papers-content"} aria-expanded="false">
          View collection <span aria-hidden="true">→</span>
        </button>
        <div class="dashboard-carousel-controls" aria-label={`${notes.length ? "Study notes" : "Past paper"} controls`}>
          <button type="button" data-carousel-target={`${subject}-featured-carousel`} data-carousel-direction="-1" aria-label={`Scroll ${notes.length ? "study notes" : "past papers"} left`} title="Scroll left">←</button>
          <button type="button" data-carousel-target={`${subject}-featured-carousel`} data-carousel-direction="1" aria-label={`Scroll ${notes.length ? "study notes" : "past papers"} right`} title="Scroll right">→</button>
        </div>
      </div>
      <div class="dashboard-resource-grid dashboard-carousel-track" id={`${subject}-featured-carousel`} tabindex="0" aria-label={`Featured ${notes.length ? "study notes" : "past papers"} for ${name}`}>
        {featured.map((item) => (
          <a class="dashboard-resource-card" href={readerHref(item)} aria-label={`Open ${item.title || item.originalFilename}`}>
            <span class="dashboard-preview" data-preview-url={["pdf", "docx", "png", "jpg", "jpeg", "webp"].includes(item.extension || "") ? item.publicUrl : undefined} data-preview-format={item.extension} data-preview-worker={`${base}full_page_flipbook_viewer/js/pdf.worker.min.js`} aria-hidden="true">
              <span class="dashboard-preview-placeholder">{item.resourceType === "paper" ? "✍" : icon}</span>
              {["pdf", "docx", "png", "jpg", "jpeg", "webp"].includes(item.extension || "") && <span class="dashboard-preview-caption">Loading page preview…</span>}
              {!["pdf", "docx", "png", "jpg", "jpeg", "webp"].includes(item.extension || "") && <span class="dashboard-preview-caption">{item.extension?.toUpperCase() || "FILE"} · Open to view</span>}
            </span>
            <span class="dashboard-resource-copy">
              <span class="dashboard-card-title">{item.title || item.originalFilename}</span>
              <span class="dashboard-card-meta">{itemLabel(item)}</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="dashboard-section dashboard-subjects" id="subjects" aria-labelledby={`${subject}-subjects-heading`}>
    <div class="dashboard-section-heading">
      <div><p class="dashboard-eyebrow">Keep exploring</p><h2 id={`${subject}-subjects-heading`}>Browse by subject</h2></div>
      <a href={`${base}subjects.html`}>All subjects <span aria-hidden="true">→</span></a>
    </div>
    <div class="dashboard-subject-carousel" data-subject-carousel tabindex="0" role="region" aria-label="Browse all Study Hub subjects">
      <div class="dashboard-subject-track">
        <div class="dashboard-subject-group">
          {subjects.map((entry) => (
            <a class={`dashboard-subject-chip ${entry.slug}`} href={`${base}frontend/src/html/${entry.slug}.html`} aria-label={`Explore ${entry.name}`}>
              <span aria-hidden="true">{entry.icon}</span><strong>{entry.name}</strong>
            </a>
          ))}
        </div>
        <div class="dashboard-subject-group" aria-hidden="true">
          {subjects.map((entry) => (
            <a class={`dashboard-subject-chip ${entry.slug}`} href={`${base}frontend/src/html/${entry.slug}.html`} tabindex="-1">
              <span aria-hidden="true">{entry.icon}</span><strong>{entry.name}</strong>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</main>

<script is:inline src={`${base}scripts/dashboard-previews.js`} defer></script>
<script>
  const updateCarouselControls = (track: HTMLElement) => {
    const controls = document.querySelectorAll<HTMLButtonElement>(`[data-carousel-target="${track.id}"]`);
    const maxScroll = track.scrollWidth - track.clientWidth;
    controls.forEach((control) => {
      const direction = Number(control.dataset.carouselDirection);
      control.disabled = direction < 0 ? track.scrollLeft <= 1 : track.scrollLeft >= maxScroll - 1;
    });
  };

  document.querySelectorAll<HTMLElement>(".dashboard-carousel-track").forEach((track) => {
    updateCarouselControls(track);
    track.addEventListener("scroll", () => updateCarouselControls(track), { passive: true });
    window.addEventListener("resize", () => updateCarouselControls(track));
  });

  document.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-carousel-target]");
    if (!button) return;
    const track = document.getElementById(button.dataset.carouselTarget || "");
    if (!track) return;

    const direction = Number(button.dataset.carouselDirection);
    const card = track.querySelector<HTMLElement>(".dashboard-resource-card");
    const distance = card ? card.offsetWidth + 12 : track.clientWidth;
    track.scrollBy({
      left: direction * distance,
      behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
    });
  });

  const subjectCarousel = document.querySelector<HTMLElement>("[data-subject-carousel]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (subjectCarousel && !reducedMotion.matches) {
    const groups = subjectCarousel.querySelectorAll<HTMLElement>(".dashboard-subject-group");
    let animationFrame = 0;
    let previousTime = 0;
    let resumeTimer = 0;
    let paused = false;
    const speed = 24;

    const animateSubjects = (time: number) => {
      if (!previousTime) previousTime = time;
      if (!paused && groups.length === 2) {
        subjectCarousel.scrollLeft += (time - previousTime) * speed / 1000;
        const loopDistance = groups[1].offsetLeft - groups[0].offsetLeft;
        if (loopDistance > 0 && subjectCarousel.scrollLeft >= loopDistance) {
          subjectCarousel.scrollLeft -= loopDistance;
        }
      }
      previousTime = time;
      animationFrame = requestAnimationFrame(animateSubjects);
    };

    const pauseForInteraction = () => {
      paused = true;
      window.clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(() => {
        paused = false;
        previousTime = 0;
      }, 1800);
    };

    subjectCarousel.addEventListener("pointerdown", pauseForInteraction);
    subjectCarousel.addEventListener("wheel", pauseForInteraction, { passive: true });
    subjectCarousel.addEventListener("touchstart", pauseForInteraction, { passive: true });
    subjectCarousel.addEventListener("keydown", pauseForInteraction);
    subjectCarousel.addEventListener("focusin", () => { paused = true; });
    subjectCarousel.addEventListener("focusout", (event) => {
      if (!subjectCarousel.contains(event.relatedTarget as Node | null)) {
        paused = false;
        previousTime = 0;
      }
    });
    subjectCarousel.addEventListener("mouseenter", () => { paused = true; });
    subjectCarousel.addEventListener("mouseleave", () => {
      paused = false;
      previousTime = 0;
    });
    document.addEventListener("visibilitychange", () => {
      paused = document.hidden;
      previousTime = 0;
    });
    reducedMotion.addEventListener("change", () => {
      if (reducedMotion.matches) {
        cancelAnimationFrame(animationFrame);
        window.clearTimeout(resumeTimer);
      } else {
        previousTime = 0;
        animationFrame = requestAnimationFrame(animateSubjects);
      }
    });

    animationFrame = requestAnimationFrame(animateSubjects);
  }
</script>

<style>
  .subject-dashboard {
    --dashboard-accent: #28634f;
    --dashboard-accent-soft: #e8f2eb;
    max-width: 1180px;
    margin: 28px auto 20px;
    padding: 0 28px;
    color: #192b3b;
    font-family: "DM Sans", Arial, sans-serif;
  }
  .subject-dashboard[data-subject="chemistry"] { --dashboard-accent: #94621c; --dashboard-accent-soft: #fff3dc; }
  .subject-dashboard[data-subject="mathematics"] { --dashboard-accent: #315c91; --dashboard-accent-soft: #eaf1fb; }
  .subject-dashboard[data-subject="physics"] { --dashboard-accent: #286d7a; --dashboard-accent-soft: #e5f3f4; }
  .dashboard-hero {
    position: relative;
    display: flex;
    min-height: 240px;
    align-items: center;
    justify-content: space-between;
    overflow: hidden;
    padding: 38px clamp(24px, 5vw, 58px);
    border-radius: 18px;
    background: radial-gradient(circle at 85% 20%, rgba(255,255,255,.13), transparent 26%), linear-gradient(125deg, #102a42, #1c4058);
    color: white;
  }
  .dashboard-welcome { position: relative; z-index: 1; max-width: 680px; }
  .dashboard-eyebrow { margin: 0 0 8px; color: var(--dashboard-accent); font-size: .72rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .dashboard-hero .dashboard-eyebrow { color: #b8daca; }
  .dashboard-hero h1 { max-width: 660px; margin: 0; color: #fff; font-family: Manrope, Arial, sans-serif; font-size: clamp(2rem, 4.2vw, 3.5rem); line-height: 1.08; }
  .dashboard-hero p:not(.dashboard-eyebrow) { max-width: 620px; margin: 14px 0 0; color: rgba(255,255,255,.77); }
  .dashboard-hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin-top: 22px; }
  .dashboard-primary { display: inline-flex; min-height: 44px; align-items: center; gap: 16px; padding: 0 17px; border-radius: 7px; background: #f0b642; color: #1b2d3d; font-size: .88rem; font-weight: 800; text-decoration: none; }
  .dashboard-primary:hover { background: #ffca62; }
  .dashboard-public-note { color: rgba(255,255,255,.68); font-size: .82rem; }
  .dashboard-subject-mark { display: grid; width: 150px; height: 150px; flex: 0 0 auto; align-content: center; justify-items: center; gap: 8px; margin-left: 30px; border: 1px solid rgba(255,255,255,.2); border-radius: 50%; background: rgba(255,255,255,.06); }
  .dashboard-subject-mark span { font-size: 3.8rem; line-height: 1; }
  .dashboard-subject-mark small { color: #c6d6df; font-size: .65rem; font-weight: 800; letter-spacing: .16em; }
  .dashboard-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin: 17px 0; }
  .dashboard-stat { display: flex; min-height: 80px; align-items: center; gap: 12px; padding: 14px 17px; border: 1px solid #e0e6e9; border-radius: 12px; background: #fff; }
  .dashboard-stat-icon { display: grid; width: 40px; height: 40px; flex: 0 0 auto; place-items: center; border-radius: 11px; background: var(--dashboard-accent-soft); color: var(--dashboard-accent); font-size: 1.2rem; font-weight: 800; }
  .dashboard-stat div { display: grid; gap: 1px; }
  .dashboard-stat strong { font-size: 1.25rem; line-height: 1.2; }
  .dashboard-stat div span { color: #657483; font-size: .78rem; }
  .dashboard-library-links { display: flex; flex-wrap: wrap; gap: 10px 20px; margin: 18px 0 30px; }
  .dashboard-library-links button { padding: 0; border: 0; background: transparent; color: var(--dashboard-accent); font: inherit; font-size: .86rem; font-weight: 800; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .dashboard-section { margin: 28px 0; }
  .curriculum-overview { padding: 20px 22px; border: 1px solid #e0e6e9; border-radius: 12px; background: #fff; }
  .curriculum-overview .dashboard-section-heading { margin-bottom: 12px; }
  .curriculum-details { display: flex; flex-wrap: wrap; gap: 12px 28px; }
  .curriculum-details > p { display: grid; gap: 2px; margin: 0; color: #657483; font-size: .82rem; }
  .curriculum-details strong { color: #213448; font-size: .76rem; }
  .curriculum-details code { color: var(--dashboard-accent); font-size: .82rem; }
  .curriculum-details .curriculum-note { flex-basis: 100%; margin-top: 4px; }
  .dashboard-section-heading { display: flex; align-items: end; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  .dashboard-section-heading .dashboard-eyebrow { margin-bottom: 4px; }
  .dashboard-section-heading h2 { margin: 0; font-family: Manrope, Arial, sans-serif; font-size: clamp(1.3rem, 2vw, 1.7rem); }
  .dashboard-section-heading > a, .dashboard-text-button { padding: 0; border: 0; background: none; color: var(--dashboard-accent); font: inherit; font-size: .82rem; font-weight: 800; text-decoration: none; white-space: nowrap; cursor: pointer; }
  .dashboard-section-heading > a:hover, .dashboard-text-button:hover { text-decoration: underline; text-underline-offset: 3px; }
  .dashboard-resource-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .dashboard-carousel-track { display: flex; gap: 12px; overflow-x: auto; padding: 2px 2px 12px; scroll-snap-type: x mandatory; overscroll-behavior-inline: contain; scrollbar-color: #9aa9a2 #e9eeeb; scrollbar-width: thin; }
  .dashboard-carousel-track:focus-visible { outline: 3px solid color-mix(in srgb, var(--dashboard-accent) 45%, transparent); outline-offset: 3px; }
  .dashboard-resource-card { display: flex; min-width: 0; min-height: 252px; flex: 0 0 clamp(220px, 26%, 280px); flex-direction: column; overflow: hidden; border: 1px solid #e0e6e9; border-radius: 12px; background: #fff; color: #213448; text-decoration: none; scroll-snap-align: start; transition: border-color .15s, transform .15s, box-shadow .15s; }
  .dashboard-resource-card:hover { transform: translateY(-2px); border-color: var(--dashboard-accent); box-shadow: 0 8px 20px rgba(25,43,59,.08); }
  .dashboard-preview { position: relative; display: grid; width: 100%; height: 158px; flex: 0 0 158px; place-items: center; overflow: hidden; background: linear-gradient(145deg, var(--dashboard-accent-soft), #f5f7f7); }
  .dashboard-preview :global(canvas) { position: absolute; inset: 0; display: block; width: 100%; height: 100%; max-width: 100%; max-height: 100%; object-fit: contain; opacity: 0; transition: opacity .2s; }
  :global(.dashboard-preview-image) { position: absolute; inset: 0; display: block; width: 100%; height: 100%; max-width: 100%; max-height: 100%; object-fit: contain; }
  :global(.dashboard-preview-document) { position: absolute; top: 0; left: 50%; width: 816px; height: 1056px; overflow: hidden; transform-origin: top center; pointer-events: none; }
  :global(.dashboard-preview-document .docx-wrapper) { width: 816px !important; margin: 0 !important; padding: 0 !important; background: white !important; }
  :global(.dashboard-preview-document .docx-wrapper > section.docx) { width: 816px !important; min-height: 1056px !important; margin: 0 !important; padding: 40px !important; box-sizing: border-box; }
  .dashboard-preview.has-preview :global(canvas) { opacity: 1; }
  .dashboard-preview.has-preview .dashboard-preview-placeholder,
  .dashboard-preview.has-preview .dashboard-preview-caption { display: none; }
  .dashboard-preview-placeholder { color: var(--dashboard-accent); font-size: 2.5rem; }
  .dashboard-preview-caption { position: absolute; right: 8px; bottom: 7px; left: 8px; overflow: hidden; color: #526273; font-size: .67rem; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
  .dashboard-preview.preview-error .dashboard-preview-caption { color: #667583; }
  .dashboard-resource-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; align-items: flex-start; padding: 12px 14px; }
  .dashboard-card-title { display: -webkit-box; overflow: hidden; width: 100%; font-size: .88rem; font-weight: 800; line-height: 1.35; overflow-wrap: anywhere; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  .dashboard-card-meta { margin-top: auto; padding-top: 7px; color: #526273; font-size: .73rem; }
  .dashboard-carousel-controls { display: flex; gap: 6px; margin-left: auto; }
  .dashboard-carousel-controls button { display: grid; width: 36px; height: 36px; place-items: center; border: 1px solid #cbd5d1; border-radius: 50%; background: #fff; color: #24394c; font: inherit; font-size: 1rem; cursor: pointer; }
  .dashboard-carousel-controls button:hover:not(:disabled) { border-color: var(--dashboard-accent); color: var(--dashboard-accent); }
  .dashboard-carousel-controls button:disabled { color: #82909b; cursor: not-allowed; opacity: .55; }
  .dashboard-carousel-controls button:focus-visible { outline: 3px solid color-mix(in srgb, var(--dashboard-accent) 45%, transparent); outline-offset: 2px; }
  .dashboard-subject-carousel { overflow-x: auto; padding: 5px 3px 12px; scroll-behavior: auto; scrollbar-color: #9aa9a2 #e9eeeb; scrollbar-width: thin; overscroll-behavior-inline: contain; touch-action: pan-x; }
  .dashboard-subject-carousel:focus-visible { outline: 3px solid color-mix(in srgb, var(--dashboard-accent) 45%, transparent); outline-offset: 2px; }
